{"manifest":{"schema":1,"apiVersion":2,"id":"kai.workflows","name":"Workflows","version":"0.1.1","description":"Build reusable local agents and workflows with saved runs and human review.","entry":"index.html","permissions":["models.read","workflows.read","workflows.write","workflows.run"]},"files":{"app.js":"\"use strict\";\nconst $ = id => document.getElementById(id), state = { workflows: [], agents: [], models: [], steps: [], editing: null, agentId: null, launchId: null, runId: null, advanced: false, polling: false, selectedStep: 0 };\nconst call = (method, input) => window.kai.call(method, input);\nconst banner = window.KaiPluginNotice.attach($(\"notice\"), { focusTarget: () => document.querySelector(\"nav button.active\") });\nfunction notice(message, error = false, force = true) { banner.show(message, { error, force }); }\nfunction act(fn) { return async event => { const button = event?.currentTarget; if (button?.tagName === \"BUTTON\") button.disabled = true; try { await fn(event); } catch (e) { notice(e.message || String(e), true); } finally { if (button?.isConnected) button.disabled = false; } }; }\nfunction el(tag, text, className) { const node = document.createElement(tag); if (text !== undefined) node.textContent = text; if (className) node.className = className; return node; }\nfunction button(text, fn, className = \"small\") { const node = el(\"button\", text, className); node.addEventListener(\"click\", act(fn)); return node; }\nfunction field(label, input) { const node = el(\"label\", label); node.append(input); return node; }\nfunction input(value, change, area = false) { const node = el(area ? \"textarea\" : \"input\"); node.value = value || \"\"; if (area) node.rows = 3; node.addEventListener(\"input\", () => change(node.value)); return node; }\nfunction select(options, value, change) { const node = el(\"select\"); for (const [id, label] of options) { const option = el(\"option\", label); option.value = id; node.append(option); } node.value = value || \"\"; node.addEventListener(\"change\", () => change(node.value)); return node; }\nfunction fillModels(node, value = \"\") { node.replaceChildren(); const options = [[\"\", \"Choose an installed model\"], ...state.models.map(m => [m.alias, m.label || m.alias])]; for (const [id, label] of options) { const option = el(\"option\", label); option.value = id; node.append(option); } node.value = value; }\nfunction tab(name) { if (name !== \"workflows\") closeEditor(); document.querySelectorAll(\".panel\").forEach(node => { node.hidden = node.id !== name; }); document.querySelectorAll(\"nav button\").forEach(node => (node.classList.toggle(\"active\", node.dataset.tab === name), node.setAttribute(\"aria-current\", node.dataset.tab === name ? \"page\" : \"false\"))); if (name === \"runs\") void refreshRuns().catch(e => notice(e.message, true)); }\nfunction empty(container, message) { if (!container.childElementCount) container.append(el(\"div\", message, \"empty\")); }\nasync function refresh() {\n  const [flows, agents, models] = await Promise.all([call(\"workflows.list\"), call(\"workflows.agents\"), call(\"models.list\")]);\n  state.workflows = flows.workflows; state.agents = agents; state.models = models.filter(m => m.status === \"ready\");\n  $(\"flow-count\").textContent = state.workflows.length; $(\"agent-count\").textContent = agents.length; renderFlows(); renderAgents();\n  if (!state.models.length) notice(\"Install a local model in KAI Core to create reasoning steps. Output and review flows work without a model.\");\n}\nfunction renderFlows() {\n  const container = $(\"flow-list\"); container.replaceChildren();\n  for (const flow of state.workflows.filter(flow => `${flow.name} ${flow.description || \"\"}`.toLowerCase().includes($(\"workflow-filter\").value.trim().toLowerCase()))) {\n    const card = el(\"article\", undefined, \"card flow-row\"), info = el(\"div\", undefined, \"flow-info\");\n    card.append(el(\"span\", \"⑂\", \"flow-icon\"), info); info.append(el(\"h3\", flow.name), el(\"p\", flow.description || \"A reusable sequence of local steps.\"), el(\"div\", flow.runnable ? \"Manual flow\" : \"Preserved flow\", \"badge\"));\n    if (flow.unavailableReason) info.append(el(\"p\", flow.unavailableReason, \"unavailable\"));\n    const actions = el(\"div\", undefined, \"actions\");\n    if (!flow.unavailableReason) {\n      actions.append(button(\"Run →\", () => openLaunch(flow), \"small primary\"), button(\"Edit\", async () => openDraft(await call(\"workflows.get\", { id: flow.id }))), button(\"Export\", async () => { $(\"exchange\").hidden = false; $(\"exchange-json\").value = JSON.stringify(await call(\"workflows.export\", { id: flow.id }), null, 2); $(\"exchange\").scrollIntoView({ behavior: \"smooth\" }); }), button(\"Delete\", async () => { if (!window.confirm(\"Delete this workflow and its plugin run history?\")) return; await call(\"workflows.remove\", { id: flow.id }); await refresh(); }, \"small danger\"));\n    }\n    card.append(actions); container.append(card);\n  }\n  empty(container, $(\"workflow-filter\").value.trim() ? \"No workflows match your search.\" : \"No workflows yet. Start from a template or build your own flow.\");\n}\nfunction newDraft() { state.editing = null; state.selectedStep = 0; state.steps = [{ type: \"agent\", label: \"Think\", text: \"Respond to this request:\\n{{input}}\" }, { type: \"output\", label: \"Result\", text: \"{{previous}}\" }]; state.advanced = false; $(\"flow-name\").value = \"\"; $(\"flow-description\").value = \"\"; fillModels($(\"flow-model\"), state.models[0]?.alias); showEditor(); }\nfunction closeEditor() { $(\"editor\").hidden = true; $(\"workflow-library\").hidden = false; }\nfunction showEditor() { tab(\"workflows\"); $(\"workflow-library\").hidden = true; $(\"exchange\").hidden = true; $(\"editor\").hidden = false; $(\"editor-title\").textContent = state.editing ? \"Edit workflow\" : \"New workflow\"; renderSteps(); $(\"editor\").scrollIntoView({ behavior: \"smooth\", block: \"start\" }); }\nfunction openDraft(flow) {\n  state.editing = flow.id || null; $(\"flow-name\").value = flow.name || \"Imported workflow\"; $(\"flow-description\").value = flow.description || \"\"; fillModels($(\"flow-model\"), flow.model || \"\"); state.advanced = true; $(\"graph-json\").value = JSON.stringify(flow.graph, null, 2); state.steps = []; showEditor(); notice(\"Review the graph before saving. Existing graph definitions are edited without losing their settings.\");\n}\nconst STEP_TYPES = [[\"agent\", \"Local agent\"], [\"saved_agent\", \"Saved agent\"], [\"sub_workflow\", \"Saved workflow\"], [\"approval\", \"Human review\"], [\"output_parser\", \"Parse output\"], [\"output\", \"Result\"]];\nfunction renderCanvas() {\n  const canvas = $(\"workflow-canvas\"); canvas.replaceChildren();\n  if (state.advanced) {\n    try {\n      const graph = JSON.parse($(\"graph-json\").value);\n      if (!Array.isArray(graph.nodes) || !Array.isArray(graph.edges)) throw Error(\"Graph needs nodes and connections.\");\n      canvas.append(el(\"p\", \"Saved graph · connections and settings remain in Graph JSON\", \"hint\"));\n      for (const node of graph.nodes) {\n        const card = el(\"article\", undefined, \"flow-node\");\n        card.append(el(\"small\", node.type), el(\"strong\", node.label || node.id));\n        const next = graph.edges.filter(edge => edge.from === node.id).map(edge => `${edge.port || \"main\"} → ${graph.nodes.find(n => n.id === edge.to)?.label || edge.to}`);\n        if (next.length) card.append(el(\"p\", next.join(\" · \")));\n        canvas.append(card);\n      }\n    } catch { canvas.append(el(\"p\", \"Complete the graph JSON to view its nodes.\", \"hint\")); }\n    return;\n  }\n  const trigger = el(\"div\", undefined, \"flow-node trigger-node\"); trigger.append(el(\"small\", \"TRIGGER\"), el(\"strong\", \"Run manually\")); canvas.append(trigger);\n  state.steps.forEach((step, index) => {\n    canvas.append(el(\"div\", undefined, \"flow-connector\"));\n    const node = button(\"\", () => { state.selectedStep = index; renderSteps(); }, \"flow-node\" + (index === state.selectedStep ? \" selected\" : \"\"));\n    node.setAttribute(\"aria-pressed\", String(index === state.selectedStep));\n    node.setAttribute(\"aria-label\", `Edit step ${index + 1}: ${step.label || step.type}`);\n    node.append(el(\"small\", `${index + 1} · ${STEP_TYPES.find(t => t[0] === step.type)?.[1] || step.type}`), el(\"strong\", step.label || \"Untitled step\"), el(\"p\", step.text || (step.type === \"output_parser\" ? \"Parse \" + (step.format || \"json\") : \"Choose its settings\")));\n    canvas.append(node);\n  });\n}\nfunction addStep(type = \"agent\") {\n  if (state.advanced) return;\n  if (state.steps.length >= 18) return notice(\"A flow can contain up to 18 steps.\", true);\n  state.steps.push({ type, label: STEP_TYPES.find(t => t[0] === type)?.[1] || \"Step\", text: \"{{previous}}\" });\n  state.selectedStep = state.steps.length - 1; renderSteps();\n}\nfunction renderSteps() {\n  state.selectedStep = Math.max(0, Math.min(state.selectedStep, state.steps.length - 1));\n  renderCanvas(); $(\"step-palette\").hidden = state.advanced;\n  $(\"steps\").hidden = state.advanced; $(\"add-step\").hidden = state.advanced; $(\"graph-editor\").hidden = !state.advanced; $(\"template\").hidden = state.advanced;\n  $(\"advanced-toggle\").textContent = state.advanced ? \"Start fresh in step builder\" : \"Graph JSON\";\n  const container = $(\"steps\"); container.replaceChildren();\n  state.steps.forEach((s, index) => {\n    if (index !== state.selectedStep) return;\n    const row = el(\"article\", undefined, \"step\"), head = el(\"div\", undefined, \"step-head\"), controls = el(\"div\", undefined, \"actions\");\n    controls.append(button(\"↑\", () => { if (index) { [state.steps[index - 1], state.steps[index]] = [state.steps[index], state.steps[index - 1]]; state.selectedStep--; } renderSteps(); }), button(\"↓\", () => { if (index < state.steps.length - 1) { [state.steps[index + 1], state.steps[index]] = [state.steps[index], state.steps[index + 1]]; state.selectedStep++; } renderSteps(); }), button(\"Remove\", () => { state.steps.splice(index, 1); renderSteps(); }, \"small danger\"));\n    head.append(el(\"span\", \"STEP \" + String(index + 1).padStart(2, \"0\"), \"step-num\"), controls); row.append(head);\n    const grid = el(\"div\", undefined, \"form-grid\"); grid.append(field(\"Action\", select(STEP_TYPES, s.type, value => { s.type = value; renderSteps(); })), field(\"Label\", input(s.label, value => { s.label = value; renderCanvas(); }))); row.append(grid);\n    if (s.type === \"saved_agent\") row.append(field(\"Agent\", select([[\"\", \"Choose a saved agent\"], ...state.agents.map(a => [a.id, a.name])], s.agentId, value => s.agentId = value)));\n    if (s.type === \"sub_workflow\") row.append(field(\"Workflow\", select([[\"\", \"Choose a saved workflow\"], ...state.workflows.filter(w => w.runnable && w.id !== state.editing).map(w => [w.id, w.name])], s.workflowId, value => s.workflowId = value)));\n    if (s.type === \"agent\") row.append(field(\"Model\", select([[\"\", \"Use the flow's default model\"], ...state.models.map(m => [m.alias, m.label || m.alias])], s.model, value => s.model = value)));\n    if ([\"agent\", \"saved_agent\", \"approval\", \"output\"].includes(s.type)) row.append(field(s.type === \"approval\" ? \"Review message\" : s.type === \"output\" ? \"Result template\" : \"Prompt\", input(s.text, value => { s.text = value; renderCanvas(); }, true)));\n    if (s.type === \"output_parser\") { row.append(field(\"Format\", select([[\"json\", \"JSON\"], [\"csv\", \"CSV\"], [\"text\", \"Text\"]], s.format || \"json\", value => s.format = value)), field(\"Required fields (comma separated)\", input(s.required, value => s.required = value))); }\n    container.append(row);\n  });\n}\nfunction draft() { return { ...(state.editing ? { id: state.editing } : {}), name: $(\"flow-name\").value, description: $(\"flow-description\").value, model: $(\"flow-model\").value, ...(state.advanced ? { graph: JSON.parse($(\"graph-json\").value) } : { steps: state.steps }) }; }\nfunction renderAgents() {\n  const container = $(\"agent-list\"); container.replaceChildren();\n  for (const a of state.agents) { const card = el(\"article\", undefined, \"card\"), actions = el(\"div\", undefined, \"actions\"); card.append(el(\"div\", \"LOCAL AGENT\", \"badge\"), el(\"h3\", a.name), el(\"p\", a.instructions.slice(0, 160)), el(\"span\", a.model, \"hint\")); actions.append(button(\"Edit\", () => editAgent(a)), button(\"Delete\", async () => { if (!window.confirm(\"Delete this saved agent? Existing workflow copies will remain.\")) return; await call(\"workflows.agentRemove\", { id: a.id }); await refresh(); }, \"small danger\")); card.append(actions); container.append(card); }\n  empty(container, \"Create a reusable agent such as an editor, planner or reviewer. Each uses an installed local model.\");\n}\nfunction editAgent(a = {}) { state.agentId = a.id || null; $(\"agent-name\").value = a.name || \"\"; $(\"agent-instructions\").value = a.instructions || \"\"; fillModels($(\"agent-model\"), a.model || state.models[0]?.alias); $(\"agent-editor\").hidden = false; $(\"agent-editor\").scrollIntoView({ behavior: \"smooth\" }); }\nfunction openLaunch(flow) { state.launchId = flow.id; $(\"launch-title\").textContent = \"Run · \" + flow.name; $(\"run-input\").value = \"\"; $(\"launch\").hidden = false; $(\"launch\").scrollIntoView({ behavior: \"smooth\" }); $(\"run-input\").focus(); }\nasync function refreshRuns() {\n  const runs = await call(\"workflows.runs\"), container = $(\"run-list\"); container.replaceChildren();\n  for (const r of runs) { const card = el(\"article\", undefined, \"card\"); card.append(el(\"div\", r.status.toUpperCase(), \"badge\"), el(\"h3\", r.name), el(\"p\", new Date(r.startedAt).toLocaleString()), button(\"View result\", async () => { state.runId = r.id; await showRun(); })); container.append(card); }\n  empty(container, \"Completed, paused and stopped runs appear here. Earlier app history stays preserved in its original storage.\");\n}\nasync function showRun() {\n  if (!state.runId) return; const r = await call(\"workflows.runGet\", { id: state.runId }); state.pollStatus = r.status;\n  $(\"run-detail\").hidden = false; $(\"run-title\").textContent = r.name; $(\"run-status\").textContent = r.status.toUpperCase(); $(\"run-output\").textContent = r.error || (r.status === \"waiting\" ? JSON.stringify(r.pending, null, 2) : r.previous || \"Waiting for the local model…\");\n  const actions = $(\"run-actions\"); actions.replaceChildren();\n  if (r.status === \"waiting\") actions.append(button(\"Approve and continue\", async () => { await call(\"workflows.decide\", { id: r.id, decision: \"approved\" }); await showRun(); }, \"primary\"), button(\"Reject\", async () => { await call(\"workflows.decide\", { id: r.id, decision: \"rejected\" }); await showRun(); }));\n  if ([\"running\", \"waiting\", \"interrupted\"].includes(r.status)) actions.append(button(\"Stop run\", async () => { await call(\"workflows.cancel\", { id: r.id }); await showRun(); await refreshRuns(); }, \"danger\"));\n  const steps = $(\"run-steps\"); steps.replaceChildren(); for (const s of r.steps || []) { const details = el(\"details\"); details.append(el(\"summary\", s.label + \" · \" + s.status), el(\"pre\", s.output || s.error || \"Running…\")); steps.append(details); }\n  return r;\n}\ndocument.querySelectorAll(\"nav button\").forEach(node => node.addEventListener(\"click\", () => tab(node.dataset.tab)));\n$(\"new-flow\").addEventListener(\"click\", newDraft); $(\"editor-close\").addEventListener(\"click\", closeEditor);\n$(\"add-step\").addEventListener(\"click\", () => addStep());\ndocument.querySelectorAll(\"[data-add-step]\").forEach(node => node.addEventListener(\"click\", () => addStep(node.dataset.addStep)));\n$(\"workflow-filter\").addEventListener(\"input\", renderFlows);\n$(\"graph-json\").addEventListener(\"input\", renderCanvas);\n$(\"writing-template\").addEventListener(\"click\", () => { newDraft(); $(\"template\").click(); });\n$(\"simple-template\").addEventListener(\"click\", newDraft);\n$(\"exchange-close\").addEventListener(\"click\", () => $(\"exchange\").hidden = true);\n$(\"run-close\").addEventListener(\"click\", () => { $(\"run-detail\").hidden = true; state.runId = null; });\n$(\"template\").addEventListener(\"click\", () => { state.steps = [{ type: \"agent\", label: \"Plan\", text: \"Create a concise outline for this request:\\n{{input}}\" }, { type: \"agent\", label: \"Draft\", text: \"Write a useful draft from this outline:\\n{{previous}}\" }, { type: \"approval\", label: \"Review\", text: \"Review this draft:\\n{{previous}}\" }, { type: \"agent\", label: \"Refine\", text: \"Improve the clarity of this draft while preserving its meaning:\\n{{previous}}\" }, { type: \"output\", label: \"Final result\", text: \"{{previous}}\" }]; if (!$(\"flow-name\").value) $(\"flow-name\").value = \"Plan, draft and refine\"; renderSteps(); });\n$(\"advanced-toggle\").addEventListener(\"click\", act(async () => { if (state.advanced) { if (!window.confirm(\"Replace this graph with a fresh step builder draft?\")) return; state.advanced = false; state.steps = [{ type: \"agent\", text: \"{{input}}\" }, { type: \"output\", text: \"{{previous}}\" }]; } else { const saved = await call(\"workflows.save\", draft()); state.editing = saved.id; $(\"graph-json\").value = JSON.stringify(saved.graph, null, 2); state.advanced = true; await refresh(); notice(\"Workflow saved. You can now edit its version 2 graph.\"); } renderSteps(); }));\n$(\"save-flow\").addEventListener(\"click\", act(async () => { const saved = await call(\"workflows.save\", draft()); state.editing = saved.id; await refresh(); notice(\"Workflow saved. Run it from the library when ready.\"); closeEditor(); }));\n$(\"import-toggle\").addEventListener(\"click\", () => $(\"exchange\").hidden = !$(\"exchange\").hidden);\n$(\"import-flow\").addEventListener(\"click\", act(() => { const raw = JSON.parse($(\"exchange-json\").value), flow = raw.workflow || raw; if (!flow.graph) throw Error(\"Paste a workflow with a version 2 graph.\"); openDraft({ ...flow, id: undefined }); notice(\"Imported as an unsaved draft. Review the graph, then save.\"); }));\n$(\"new-agent\").addEventListener(\"click\", () => editAgent()); $(\"agent-close\").addEventListener(\"click\", () => $(\"agent-editor\").hidden = true);\n$(\"save-agent\").addEventListener(\"click\", act(async () => { await call(\"workflows.agentSave\", { ...(state.agentId ? { id: state.agentId } : {}), name: $(\"agent-name\").value, instructions: $(\"agent-instructions\").value, model: $(\"agent-model\").value }); await refresh(); $(\"agent-editor\").hidden = true; notice(\"Agent saved. Choose Saved agent when adding a workflow step.\"); }));\n$(\"launch-close\").addEventListener(\"click\", () => $(\"launch\").hidden = true);\n$(\"start-run\").addEventListener(\"click\", act(async () => { const r = await call(\"workflows.run\", { id: state.launchId, input: $(\"run-input\").value }); state.runId = r.id; $(\"launch\").hidden = true; tab(\"runs\"); await showRun(); notice(\"Run started locally. Keep this plugin window open.\"); }));\n$(\"refresh-runs\").addEventListener(\"click\", act(refreshRuns));\nsetInterval(async () => { if (state.polling || !state.runId || $(\"runs\").hidden || [\"completed\", \"failed\", \"cancelled\"].includes(state.pollStatus)) return; state.polling = true; try { const r = await showRun(); if ([\"completed\", \"failed\", \"cancelled\"].includes(r.status)) await refreshRuns(); } catch (e) { notice(e.message, true, false); } finally { state.polling = false; } }, 1800);\nvoid refresh().catch(e => notice(e.message || \"Open this plugin from KAI Core to connect to its local runtime.\", true));\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>KAI Workflows</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<header class=\"workspace-header\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 4h5v5H5zM14 15h5v5h-5zM7.5 9v8.5H14M10 6.5h6.5V15\"/></svg><h1>Workflows</h1><span class=\"workspace-caption\">Your local workspace</span></header>\n<div class=\"hub-shell\"><nav class=\"hub-rail\" aria-label=\"Workflow sections\"><div class=\"hub-rail-label\">WORKFLOWS</div><button data-tab=\"workflows\" class=\"active\">Your workflows <span id=\"flow-count\">0</span></button><button data-tab=\"agents\">Reusable agents <span id=\"agent-count\">0</span></button><button data-tab=\"runs\">Run history</button></nav>\n<main class=\"hub-content\"><p id=\"notice\" role=\"status\" aria-live=\"polite\" data-kai-notice></p>\n<section id=\"workflows\" class=\"panel\"><div id=\"workflow-library\"><div class=\"section-head page-heading\"><div><h2>Your routines, connected</h2><p>Build a flow once. Run it when you need it.</p></div><div class=\"actions\"><button id=\"import-toggle\">Import / export</button><button id=\"new-flow\" class=\"primary\">New workflow</button></div></div><div class=\"list-tools\"><label class=\"sr-only\" for=\"workflow-filter\">Search workflows</label><input id=\"workflow-filter\" type=\"search\" placeholder=\"Search workflows\"><span>Saved on this device</span></div><div id=\"flow-list\" class=\"cards saved-list\"></div><div class=\"section-head template-heading\"><h3>Start from a template</h3></div><div class=\"template-cards\"><button id=\"writing-template\" class=\"template-card\"><span class=\"template-icon\" aria-hidden=\"true\">⑂</span><strong>Plan, draft and refine</strong><p>Build an outline, write a draft, review it, and improve the final result.</p><small>Use template →</small></button><button id=\"simple-template\" class=\"template-card\"><span class=\"template-icon\" aria-hidden=\"true\">◇</span><strong>Ask a local agent</strong><p>Give an agent a request and keep its answer as your workflow result.</p><small>Use template →</small></button></div></div>\n<section id=\"editor\" class=\"editor workflow-editor\" hidden><div class=\"builder-header\"><button id=\"editor-close\" title=\"Back to workflows\" aria-label=\"Back to workflows\">←</button><div class=\"builder-title\"><h2 id=\"editor-title\">New workflow</h2><span id=\"draft-note\" class=\"hint\">Manual execution · Up to 18 steps</span></div><button id=\"save-flow\" class=\"primary\">Save workflow</button></div><div class=\"builder-details\"><div class=\"form-grid\"><label>Name<input id=\"flow-name\" maxlength=\"100\" placeholder=\"Research, draft and refine\"></label><label>Default local model<select id=\"flow-model\"></select></label></div><label>Description<input id=\"flow-description\" maxlength=\"1000\" placeholder=\"What should this flow help you do?\"></label></div><div class=\"builder-tools\"><span>Select a step to edit its settings.</span><div class=\"actions\"><button id=\"template\">Use writing template</button><button id=\"advanced-toggle\">Graph JSON</button></div></div><div class=\"builder-body\"><aside id=\"step-palette\" class=\"step-palette\"><h3>Add a step</h3><button data-add-step=\"agent\">✦ <span>Local agent</span></button><button data-add-step=\"saved_agent\">◇ <span>Saved agent</span></button><button data-add-step=\"sub_workflow\">⑂ <span>Workflow</span></button><button data-add-step=\"approval\">✓ <span>Human review</span></button><button data-add-step=\"output_parser\">≡ <span>Parse output</span></button><button data-add-step=\"output\">↗ <span>Result</span></button></aside><div id=\"workflow-canvas\" class=\"workflow-canvas\" aria-label=\"Workflow steps\"></div><aside class=\"step-inspector\"><h3>Step settings</h3><div id=\"steps\"></div><label id=\"graph-editor\" hidden>Version 2 graph<textarea id=\"graph-json\" class=\"code\" rows=\"20\" spellcheck=\"false\"></textarea></label><p class=\"hint\">Use {{input}} for your original request and {{previous}} for the preceding result.</p><button id=\"add-step\">Add step</button></aside></div></section>\n<section id=\"exchange\" class=\"editor\" hidden><div class=\"section-head\"><h2>Import / export workflow</h2><button id=\"exchange-close\" type=\"button\" aria-label=\"Close import and export\" title=\"Close\">×</button></div><p class=\"hint\">Copy a definition to share it, or paste one to review as a draft. Review prompts before sharing; nested workflow IDs refer to your local library.</p><textarea id=\"exchange-json\" class=\"code\" rows=\"10\" spellcheck=\"false\" aria-label=\"Workflow definition JSON\"></textarea><button id=\"import-flow\">Review imported workflow</button></section>\n</section>\n<section id=\"agents\" class=\"panel\" hidden><div class=\"section-head page-heading\"><div><h2>Reusable agents</h2><p>Save a specialist, then add it to any workflow.</p></div><button id=\"new-agent\" class=\"primary\">New agent</button></div><div id=\"agent-list\" class=\"cards\"></div><section id=\"agent-editor\" class=\"editor\" hidden><div class=\"section-head\"><h2>Agent profile</h2><button id=\"agent-close\" aria-label=\"Close agent editor\" title=\"Close\">×</button></div><div class=\"form-grid\"><label>Name<input id=\"agent-name\" maxlength=\"100\" placeholder=\"Editor\"></label><label>Local model<select id=\"agent-model\"></select></label></div><label>Instructions<textarea id=\"agent-instructions\" rows=\"6\" maxlength=\"4000\" placeholder=\"You are a careful editor. Improve clarity and preserve the author's meaning.\"></textarea></label><button id=\"save-agent\" class=\"primary\">Save agent</button></section></section>\n<section id=\"runs\" class=\"panel\" hidden><div class=\"section-head page-heading\"><div><h2>Every run, step by step</h2><p>Inspect results and decisions. Paused runs wait here for you.</p></div><button id=\"refresh-runs\">Refresh</button></div><div id=\"run-list\" class=\"cards saved-list\"></div><section id=\"run-detail\" class=\"editor\" hidden><div class=\"section-head\"><h2 id=\"run-title\">Run</h2><div class=\"actions\"><span id=\"run-status\" class=\"pill\"></span><button id=\"run-close\" aria-label=\"Close run details\" title=\"Close\">×</button></div></div><pre id=\"run-output\"></pre><div id=\"run-actions\" class=\"actions\"></div><div id=\"run-steps\"></div></section></section>\n<section id=\"launch\" class=\"editor\" hidden><div class=\"section-head\"><h2 id=\"launch-title\">Run workflow</h2><button id=\"launch-close\" aria-label=\"Close workflow input\" title=\"Close\">×</button></div><p class=\"hint\">Only this input and the flow's instructions go to your local model. Keep this window open while the run is active.</p><label>Input<textarea id=\"run-input\" rows=\"4\" maxlength=\"16000\" placeholder=\"What should this workflow work on?\"></textarea></label><button id=\"start-run\" class=\"primary\">Run locally →</button></section>\n<details class=\"capability-note\"><summary>Workflow capabilities</summary><p>Local models, saved agents, output parsing and human review are available. Brain access, connected accounts, schedules and native actions are unavailable in this plugin release. Existing flows that need them are preserved.</p></details></main></div><script src=\"kai-notices.js\"></script><script src=\"app.js\"></script></body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","style.css":":root{color-scheme:light;--bg:#f4f7fd;--panel:#fff;--line:#dce5f2;--border:#dce5f2;--text:#14284e;--muted:#61728d;--accent:#155eef;--danger:#c93d4c;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{background:#fff;color:var(--text);border:1px solid var(--border);padding:8px 12px;border-radius:9px;cursor:pointer;font-size:12px}button:hover:enabled{background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.45;cursor:default}.primary{background:var(--accent);border-color:var(--accent);color:#fff}.primary:hover:enabled{background:#0c4ed3;color:#fff}.danger{color:var(--danger)}input,select,textarea{width:100%;min-width:0;max-width:100%;padding:9px 11px;background:#fff;border:1px solid var(--border);border-radius:9px;color:var(--text);font-size:12px}textarea{resize:vertical;line-height:1.7}label{display:flex;flex-direction:column;gap:7px;margin-bottom:15px;font-size:12px;color:var(--muted)}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.workspace-header{height:74px;display:flex;align-items:center;padding:0 26px;gap:11px;border-bottom:1px solid var(--border);background:var(--bg)}.workspace-header svg{width:20px;height:20px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-header h1{font-size:15px;font-weight:650;margin:0}.workspace-caption{margin-left:auto;font-size:10px;color:var(--muted)}.hub-shell{display:grid;grid-template-columns:170px minmax(0,1fr);min-height:calc(100dvh - 74px)}.hub-rail{padding:20px 10px 24px 12px;border-right:1px solid var(--border);background:#fff;display:flex;flex-direction:column;gap:3px}.hub-rail-label{font-size:9px;letter-spacing:.09em;padding:3px 8px 15px;color:var(--muted)}.hub-rail button{text-align:left;border:0;background:transparent;font-size:12px;min-height:37px;padding:10px 9px;display:flex;justify-content:space-between;align-items:center;gap:5px}.hub-rail button span{font-size:10px;color:var(--muted)}.hub-rail button.active{color:var(--accent);background:#edf4ff;font-weight:600}.hub-content{padding:26px;min-width:0}.section-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:18px}.page-heading{align-items:flex-start;margin-bottom:24px}.section-head h2{font-size:18px;line-height:1.3;margin:0}.page-heading h2{font-size:24px;letter-spacing:-.6px;margin-bottom:9px}.section-head p{margin:0;color:var(--muted);font-size:12px;line-height:1.7}.section-head h3{margin:0;font-size:15px}p{font-size:12px;color:var(--muted);line-height:1.7}.actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,260px),1fr));gap:14px}.saved-list{grid-template-columns:1fr}.card{min-width:0;padding:21px;border:1px solid var(--border);background:#fff;border-radius:12px}.card h3{font-size:15px;margin:10px 0 7px;overflow-wrap:anywhere}.card p{margin:0 0 15px;overflow-wrap:anywhere}.card .actions{margin-top:14px}.small{font-size:11px;padding:7px 10px}.badge,.pill{display:inline-block;font-size:10px;color:var(--accent);background:#edf4ff;border-radius:6px;padding:4px 8px;line-height:1.4}.hint{font-size:11px;color:var(--muted);line-height:1.6}.unavailable{color:#916420!important}.empty{padding:45px 24px;text-align:center;color:var(--muted);font-size:12px;background:#fff;border:1px solid var(--border);border-radius:12px;grid-column:1/-1}.list-tools{display:flex;align-items:center;gap:20px;justify-content:space-between;margin-bottom:14px}.list-tools input{max-width:300px}.list-tools>span{font-size:11px;color:var(--muted)}.flow-row{display:flex;align-items:center;gap:15px}.flow-icon{width:42px;height:42px;flex:none;display:grid;place-items:center;background:#edf4ff;color:var(--accent);border-radius:11px;font-size:25px}.flow-info{flex:1;min-width:0}.flow-info h3{margin:0 0 5px}.flow-info p{margin:5px 0 9px}.flow-row>.actions{margin:0;justify-content:flex-end}.template-heading{margin-top:30px}.template-cards{display:grid;grid-template-columns:1fr 1fr;gap:14px}.template-card{display:grid;grid-template-columns:34px 1fr;text-align:left;gap:7px 12px;padding:21px;align-content:start}.template-icon{grid-row:1/4;width:32px;height:32px;background:#edf4ff;color:var(--accent);border-radius:8px;display:grid;place-items:center;font-size:22px}.template-card strong{font-size:14px}.template-card p{margin:0}.template-card small{font-size:11px;color:var(--accent);margin-top:6px}.editor{padding:24px;margin-top:20px;background:#fff;border:1px solid var(--border);border-radius:14px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.code,pre{font:11px/1.7 Consolas,ui-monospace,monospace}pre{white-space:pre-wrap;overflow-wrap:anywhere;padding:16px;background:#f5f8fe;border:1px solid var(--border);border-radius:10px;max-height:400px;overflow:auto}.workflow-editor{padding:0;margin-top:0;overflow:hidden}.builder-header{display:flex;gap:15px;padding:18px 20px;align-items:center;border-bottom:1px solid var(--border)}.builder-title{flex:1;min-width:0}.builder-title h2{font-size:18px;margin:0 0 5px}.builder-details{padding:18px 20px 0;border-bottom:1px solid var(--border)}.builder-tools{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:10px 18px;border-bottom:1px solid var(--border);font-size:10px;color:var(--muted)}.builder-tools button{font-size:10px;padding:6px 9px}.builder-body{display:grid;grid-template-columns:140px minmax(200px,1fr) 270px;min-height:530px}.step-palette{padding:15px 10px;background:#fff;border-right:1px solid var(--border)}.step-palette h3{font-size:10px;color:var(--muted);margin:8px 5px 12px}.step-palette button{display:flex;align-items:center;gap:8px;width:100%;text-align:left;padding:9px 6px;border:0;margin:4px 0;color:var(--accent);font-size:17px}.step-palette button span{font-size:11px;color:var(--text)}.workflow-canvas{min-width:0;min-height:530px;max-height:700px;padding:28px 18px;overflow:auto;background-color:var(--bg);background-image:radial-gradient(var(--border) 1px,transparent 1px);background-size:20px 20px;display:flex;flex-direction:column;align-items:center}.flow-node{display:block;width:250px;max-width:100%;border:1px solid var(--border);border-radius:12px;background:#fff;box-shadow:0 4px 12px #1629460d;padding:15px;text-align:left;flex:none}.flow-node.selected{border:2px solid var(--accent);box-shadow:0 0 0 3px #4778ef15}.flow-node strong{display:block;font-size:13px;line-height:1.4}.flow-node small{display:block;font-size:9px;color:var(--muted);margin:5px 0}.flow-node p{font-size:10px;margin:9px 0 0;max-height:34px;overflow:hidden}.flow-connector{height:31px;flex:none;width:2px;background:#91a4c6;position:relative}.flow-connector:after{content:\"\";position:absolute;bottom:0;left:-3px;width:8px;height:8px;border-right:2px solid #91a4c6;border-bottom:2px solid #91a4c6;transform:rotate(45deg)}.trigger-node{background:#fffaf0;border-color:#ead7a3;color:#916420}.step-inspector{border-left:1px solid var(--border);padding:20px 17px;min-width:0;max-height:700px;overflow:auto}.step-inspector h3{margin:0 0 18px;font-size:15px}.step-inspector .form-grid{grid-template-columns:1fr;gap:0}.step-inspector .step{border:0;padding:0}.step-head{display:flex;flex-direction:column;gap:12px;margin-bottom:17px}.step-head .actions{gap:5px}.step-num{font-size:10px;color:var(--muted);letter-spacing:.08em}.step-inspector .small{font-size:10px;padding:5px 8px}.step-inspector>.hint{padding-top:15px;border-top:1px solid var(--border);margin-top:18px}.capability-note{margin:26px 0 0;font-size:11px;color:var(--muted)}.capability-note summary{cursor:pointer}.capability-note p{max-width:750px;font-size:11px}.hub-shell:has(#editor:not([hidden])){grid-template-columns:minmax(0,1fr)}.hub-shell:has(#editor:not([hidden]))>.hub-rail{display:none}.hub-content:has(#editor:not([hidden])){padding:0}.hub-content:has(#editor:not([hidden]))>.capability-note{margin:18px 24px}.hub-content:has(#editor:not([hidden]))>[data-kai-notice]{margin-inline:20px}#notice:empty{display:none}#notice{font-size:12px;line-height:1.6;color:var(--muted);overflow-wrap:anywhere}#notice.error{color:var(--danger)}#run-steps details{border-top:1px solid var(--border);padding:12px 0;font-size:12px}summary{cursor:pointer}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}[hidden]{display:none!important}@media(max-width:1050px){.builder-body{grid-template-columns:125px minmax(180px,1fr) 245px}.hub-content{padding:23px 20px}.flow-row{flex-wrap:wrap}.flow-row>.actions{margin-left:auto}}@media(max-width:800px){.hub-shell{grid-template-columns:145px minmax(0,1fr)}.hub-content{padding:20px 16px}.page-heading{flex-wrap:wrap}.page-heading h2{font-size:21px}.template-cards{grid-template-columns:1fr}.builder-body{grid-template-columns:minmax(0,1fr) 245px}.step-palette{grid-column:1/-1;display:flex;flex-wrap:wrap;border-right:0;border-bottom:1px solid var(--border);gap:5px;padding:8px}.step-palette h3{width:100%;margin:2px 5px}.step-palette button{width:auto;margin:0}.workflow-canvas{padding:25px 12px}.list-tools{flex-wrap:wrap;gap:8px}.list-tools input{max-width:none}}@media(max-width:600px){.workspace-header{height:65px;padding:0 16px}.workspace-caption{display:none}.hub-shell{grid-template-columns:1fr;min-height:calc(100dvh - 65px)}.hub-rail{flex-direction:row;flex-wrap:wrap;border-right:0;border-bottom:1px solid var(--border);padding:10px}.hub-rail-label{display:none}.hub-rail button{flex:1;justify-content:center;padding:8px;font-size:11px}.hub-content{padding:20px 14px}.builder-body{grid-template-columns:1fr}.step-inspector{border-left:0;border-top:1px solid var(--border);max-height:none}.workflow-canvas{max-height:430px;min-height:320px}.form-grid{grid-template-columns:1fr;gap:0}.builder-tools{flex-wrap:wrap}.editor{padding:18px}.workflow-editor{padding:0}.builder-header{padding:14px;gap:10px}.builder-title h2{font-size:16px}.flow-row{padding:16px}.flow-row>.actions{justify-content:flex-start;width:100%}}\n\n.workflow-canvas>article.flow-node{margin-bottom:16px}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"WGpjmnDtle2kRcEviNigfUkhw09S6Q+4ofBLC7KI9HG/BskBkRBN9OV1ZrtbT7ecfbQGGKdRjLV7Yyvu7RbiBg=="}