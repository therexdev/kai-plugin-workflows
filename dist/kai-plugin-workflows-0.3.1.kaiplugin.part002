nt;accent-color:#1765ef}.cn-mode-icon{display:grid;place-items:center;width:40px;height:40px;background:#1765ef;border-radius:12px;color:white;font-size:23px;font-weight:800;margin-bottom:20px}.cn-mode-icon.personal{background:#252932}.cn-mode-card>strong{font-size:17px}.cn-mode-card>p{font-size:13px;color:#617590;line-height:1.7;flex:1}.cn-mode-card>small{font-size:11px;color:#8191aa}.cn-key-panel{padding:22px 0;max-width:570px}.cn-key-panel p{font-size:12px;color:#71839f;line-height:1.7}.cn-key-panel a{color:#1765ef}.cn-field{display:flex;flex-direction:column;gap:8px;font-size:12px;margin:0 0 18px;color:#4d6484}.cn-field>small{font-size:11px;color:#8393a9;line-height:1.6;overflow-wrap:anywhere}.cn-workspace .cn-field input,.cn-workspace .cn-field select,.cn-workspace .cn-field textarea{background:#fff}.cn-setup-actions{display:flex;gap:10px;flex-wrap:wrap;margin:24px 0 16px}.cn-overlay{position:fixed;inset:0;background:#122c4b35;z-index:110;display:flex;justify-content:flex-end;backdrop-filter:blur(3px)}.cn-drawer{background:#f9fbff;width:min(100%,540px);height:100%;overflow-y:auto;padding:28px;box-shadow:-16px 0 70px #12325922;animation:cnDrawer .2s ease-out}.cn-drawer-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:30px}.cn-drawer-heading h2{font-size:20px;letter-spacing:-.02em;margin:0;overflow-wrap:anywhere}.cn-connect-intro .cn-logo{width:64px;height:64px;border-radius:18px}.cn-connect-intro .cn-logo img{width:42px;height:42px}.cn-connect-intro h3{font-size:23px;line-height:1.3;letter-spacing:-.03em;margin:24px 0 12px}.cn-connect-intro p{font-size:13px;color:#617590;line-height:1.8}.cn-connect-steps{counter-reset:cn-step;list-style:none;margin:30px 0;padding:0}.cn-connect-steps li{counter-increment:cn-step;display:flex;align-items:center;gap:13px;font-size:13px;color:#4d6484;margin:19px 0;line-height:1.6}.cn-connect-steps li:before{content:counter(cn-step);display:grid;place-items:center;background:#e6efff;color:#1765ef;width:28px;height:28px;border-radius:50%;flex:none;font-size:12px}.cn-existing{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-top:1px solid #e1e9f4;font-size:12px}.cn-wait-orb{display:grid;place-items:center;width:64px;height:64px;border-radius:50%;background:#e8f1ff;color:#1765ef;font-size:30px}.cn-permission{display:flex;align-items:flex-start;gap:12px;padding:15px 0;border-bottom:1px solid #e1e9f4}.cn-permission input{margin-top:3px!important;accent-color:#1765ef}.cn-permission strong{font-size:13px;display:block;color:#29466e}.cn-permission small{font-size:11px;color:#71839f;display:block;line-height:1.7;margin-top:6px}.cn-actions-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:28px 0 15px}.cn-actions-heading h3{font-size:15px;margin:0}.cn-actions-heading span{font-size:11px;color:#71839f}.cn-tool-list{margin:16px 0}.cn-tool{display:flex;align-items:flex-start;gap:12px;background:#fff;border:1px solid #e1e9f4;border-radius:11px;padding:14px;margin-bottom:9px}.cn-tool input{margin-top:3px!important;accent-color:#1765ef}.cn-tool strong{display:block;font-size:12px;color:#29466e;line-height:1.6}.cn-tool small{display:block;font-size:11px;color:#71839f;line-height:1.6;margin-top:4px}.cn-tool-type{display:inline-block;font-size:9px;font-weight:500;color:#6483ad;background:#eff5ff;padding:3px 6px;border-radius:4px;margin-top:7px}.cn-sticky-actions{position:sticky;bottom:-28px;padding:18px 0;background:#f9fbfff5;display:flex;flex-wrap:wrap;gap:8px;border-top:1px solid #e1e9f4;margin-top:24px;backdrop-filter:blur(8px)}.cn-result{white-space:pre-wrap;overflow-wrap:anywhere;background:#eaf1fb;border-radius:10px;padding:15px;max-height:340px;overflow:auto;font-size:12px}.cn-argument-fields{margin-top:24px}@keyframes cnDrawer{from{transform:translateX(22px);opacity:0}to{transform:translateX(0);opacity:1}}@media(max-width:1000px){.cn-hero{flex-direction:column;padding:23px}.cn-hero h2{font-size:23px}.cn-app-grid{grid-template-columns:repeat(auto-fill,minmax(190px,1fr))}.cn-mode-grid{grid-template-columns:1fr}}@media(max-width:760px){.cn-workspace .cn-app-card{padding:16px;min-height:210px}.cn-app-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.cn-hero h2{font-size:22px}.cn-hero{padding:20px}.cn-drawer{padding:20px}.cn-sticky-actions{bottom:-20px}.cn-app-card>p{font-size:11px}.cn-card-footer{flex-wrap:wrap;gap:8px}.cn-mode-card{padding:20px}}@media(prefers-reduced-motion:reduce){.cn-drawer{animation:none}.cn-workspace .cn-app-card{transition:none}.cn-workspace .cn-app-card:hover{transform:none}}\n\n.cn-category-picker{display:flex;align-items:center;gap:12px;color:#617590;font-size:13px}.cn-category-picker select{width:auto!important;min-width:180px;max-width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:10px;background:#fff;color:#29466e}\n\n.cn-readiness{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:16px 18px;margin-bottom:18px;border:1px solid #d5e2f3;border-radius:12px;background:#f0f6ff;color:#29456b}.cn-readiness>div{flex:1 1 240px;min-width:0}.cn-readiness strong{font-size:13px}.cn-readiness p{font-size:12px;line-height:1.6;margin:5px 0 0;overflow-wrap:anywhere}.cn-readiness .cn-button{flex:none}\n\n/* Stable, text-only action receipts below the conversation. */\n.kai-action-results { margin: 8px 0; border: 1px solid #a8bddd66; border-radius: 10px; padding: 10px 12px; max-width: 100%; font-size: 13px; overflow-wrap: anywhere; }\n.kai-action-results summary { cursor: pointer; font-weight: 600; text-align: left; }\n.kai-action-results > div { padding: 8px 0; border-top: 1px solid #a8bddd44; }\n.kai-action-results p { margin: 4px 0; font-size: 12px; line-height: 1.4; }\n.kai-action-results a { display: inline-block; margin: 4px 12px 0 0; }\n","workflow-model.js":"/* KAI's portable workflow document. Shared by the private runner and canvas. */\n(function (root, factory) {\n  const api = factory(); if (typeof module === \"object\" && module.exports) module.exports = api; else root.KaiWorkflowModel = api;\n})(typeof window === \"object\" ? window : globalThis, function () {\n  \"use strict\";\n  const clone = x => JSON.parse(JSON.stringify(x));\n  const catalog = [\n    [\"trigger\", \"Trigger\", \"Start\", \"Start manually, on a schedule, or when a source changes.\", \"⚡\"],\n    [\"agent\", \"Agent\", \"Actions\", \"Ask a local model to reason, write, or use selected read tools.\", \"✦\"],\n    [\"tool_call\", \"App action\", \"Actions\", \"Run an action from a connected app or custom API.\", \"↗\"],\n    [\"http_request\", \"HTTP request\", \"Actions\", \"Fetch a public endpoint or use a saved API connection.\", \"◎\"],\n    [\"code\", \"Code\", \"Actions\", \"Transform data with isolated JavaScript.\", \"{}\"],\n    [\"sub_workflow\", \"Sub-workflow\", \"Actions\", \"Run another saved workflow and return its result.\", \"▧\"],\n    [\"memory\", \"Brain memory\", \"Actions\", \"Search, read, remember, or forget selected Brain notes.\", \"♧\"],\n    [\"approval\", \"Human review\", \"Actions\", \"Pause for a decision and follow the approved or rejected path.\", \"✓\"],\n    [\"condition\", \"Condition\", \"Logic\", \"Route each item to a true or false branch.\", \"⑂\"],\n    [\"switch\", \"Switch\", \"Logic\", \"Route items to named cases or a fallback.\", \"⋔\"],\n    [\"merge\", \"Merge\", \"Logic\", \"Wait for branches and append, zip, or join their items.\", \"⋈\"],\n    [\"split_out\", \"Split out\", \"Logic\", \"Turn a list into individual items.\", \"⋮\"],\n    [\"transform\", \"Transform\", \"Logic\", \"Map fields with expressions using upstream data.\", \"◇\"],\n    [\"output_parser\", \"Output parser\", \"Logic\", \"Parse JSON, text, or CSV and validate required fields.\", \"≡\"],\n    [\"dedup\", \"Deduplicate\", \"Logic\", \"Skip items already seen in this workflow.\", \"⊜\"],\n    [\"loop\", \"Loop\", \"Logic\", \"Repeat a connected body a limited number of times.\", \"↻\"],\n    [\"output\", \"Result\", \"Finish\", \"Keep a result in run history or a new conversation.\", \"▤\"],\n  ].map(([type, name, group, description, icon]) => ({ type, name, group, description, icon }));\n  const types = catalog.map(x => x.type), meta = type => catalog.find(x => x.type === type);\n  function defaults(type) {\n    return clone({ trigger: { kind: \"manual\", schedule: { kind: \"daily\", hour: 9, minute: 0, day: 1 }, inputFields: [] }, agent: { prompt: \"Summarize this input and suggest next steps:\\n{{previous}}\", profile: \"assistant\", model: \"\", execution: \"once\", maxTurns: 3, tools: [] }, tool_call: { connectionId: \"\", operationId: \"\", variables: {}, body: {}, execution: \"per_item\" }, http_request: { method: \"GET\", url: \"https://api.example.com/data\", headers: {}, body: {}, execution: \"per_item\" }, code: { language: \"javascript\", source: \"return items;\" }, sub_workflow: { workflowId: \"\", execution: \"once\" }, memory: { operation: \"search\", query: \"{{input}}\", limit: 8 }, approval: { text: \"Review this result:\\n{{previous}}\" }, condition: { expression: \"=Boolean(item.text)\", operator: \"truthy\", value: \"\" }, switch: { expression: \"=item.status\", cases: [\"ready\", \"pending\"] }, merge: { mode: \"append\", key: \"id\" }, split_out: { field: \"=item.json\", keepFields: false }, transform: { set: { summary: \"=item.text\" }, keepFields: true }, output_parser: { format: \"json\", field: \"=item.text\", required: \"\" }, dedup: { key: \"=item.id\", scope: \"workflow\" }, loop: { maxIterations: 3, condition: \"\", onExceeded: \"continue\" }, output: { text: \"{{previous}}\", saveChat: false } }[type] || {});\n  }\n  const node = (type, id, position, config = {}, label) => ({ id, type, label: label || meta(type)?.name || type, config: { ...defaults(type), ...config }, position: position || { x: 80, y: 80 } });\n  const edge = (from, to, port = \"main\", input = \"main\") => ({ id: [from, port, to, input].join(\":\"), from, to, port, input });\n  function ports(n) { return [...new Set(n.type === \"condition\" ? [\"true\", \"false\", \"error\"] : n.type === \"switch\" ? [...(n.config.cases || []).map(String), \"default\", \"error\"] : n.type === \"loop\" ? [\"body\", \"done\", \"error\"] : n.type === \"approval\" ? [\"approved\", \"rejected\", \"error\"] : [\"main\", \"error\"])]; }\n  function fromLegacy(w) {\n    if (w.graph) return clone(w);\n    const nodes = [node(\"trigger\", \"start\", { x: 80, y: 80 }, { kind: w.schedule?.kind !== \"manual\" ? \"schedule\" : \"manual\", schedule: w.schedule || { kind: \"manual\" } })], edges = [];\n    (w.steps || []).forEach((s, i) => {\n      const type = { prompt: \"agent\", connection: \"tool_call\", brain_search: \"memory\", remember: \"memory\" }[s.type] || s.type;\n      const config = s.type === \"prompt\" ? { prompt: s.text, model: w.model } : s.type === \"brain_search\" ? { operation: \"search\", query: s.text || \"{{input}}\", legacyText: true } : s.type === \"remember\" ? { operation: \"remember\", title: s.label, value: s.text } : s.type === \"condition\" ? { expression: \"=item.text\", operator: \"contains\", value: s.text } : s.type === \"connection\" ? { ...s } : { text: s.text };\n      const n = node(type, \"step\" + (i + 1), { x: 80, y: 80 + (i + 1) * 150 }, config, s.label); nodes.push(n);\n      edges.push(edge(nodes[i].id, n.id, nodes[i].type === \"condition\" ? \"true\" : nodes[i].type === \"approval\" ? \"approved\" : \"main\"));\n    });\n    return { ...clone(w), graph: { version: 2, nodes, edges } };\n  }\n  // Exchange behavior, not source code: explicitly translate the documented OpenHuman wire format.\n  function importDocument(raw) {\n    const w = clone(raw.flow || raw), g = w.graph || (w.nodes ? w : null);\n    if (!g) return fromLegacy(w);\n    if (g.nodes?.some(n => n.kind)) {\n      const nodes = g.nodes.map((n, i) => {\n        const c = { ...(n.config || {}) }, type = n.kind;\n        if (type === \"trigger\") { c.kind = c.trigger_kind || \"manual\"; if (typeof c.schedule === \"string\") c.schedule = { kind: \"cron\", expression: c.schedule }; }\n        for (const [a, b] of [[\"workflow_id\", \"workflowId\"], [\"max_iterations\", \"maxIterations\"], [\"on_exceeded\", \"onExceeded\"], [\"on_error\", \"onError\"], [\"connection_ref\", \"connectionId\"]]) if (c[a] !== undefined) c[b] = c[a];\n        if (type === \"agent\") c.profile = c.agent_ref || \"assistant\";\n        if (type === \"tool_call\") { c.operationId = c.slug || \"\"; c.variables = c.args || {}; }\n        if (type === \"condition\" && c.field && !c.expression) c.expression = \"=item[\" + JSON.stringify(c.field) + \"]\";\n        return node(type, n.id, n.position || { x: 80, y: 80 + i * 150 }, c, n.name);\n      });\n      return { name: w.name || g.name || \"Imported workflow\", description: w.description || \"\", enabled: false, graph: { version: 2, nodes, edges: (g.edges || []).map(e => edge(e.from_node, e.to_node, e.from_port || \"main\", e.to_port || \"main\")) } };\n    }\n    return { ...w, graph: g, enabled: false };\n  }\n  function validateGraph(g) {\n    const errors = [], warnings = [], error = (message, nodeId) => errors.push({ message, nodeId });\n    if (!g || !Array.isArray(g.nodes) || !Array.isArray(g.edges)) return { errors: [{ message: \"Add a workflow graph.\" }], warnings };\n    if (!g.nodes.length || g.nodes.length > 60 || g.edges.length > 160) error(\"Use 1–60 nodes and at most 160 connections.\");\n    const ids = new Set(); for (const n of g.nodes) { if (!/^[a-zA-Z][a-zA-Z0-9_-]{0,63}$/.test(n.id) || ids.has(n.id)) error(\"Nodes need unique letter-led IDs.\", n.id); ids.add(n.id); if (!types.includes(n.type)) error(\"Unsupported node: \" + n.type, n.id); if (!n.config || typeof n.config !== \"object\" || Array.isArray(n.config)) error(\"Node settings must be an object.\", n.id); }\n    const triggers = g.nodes.filter(n => n.type === \"trigger\"); if (triggers.length !== 1) error(\"Add exactly one trigger.\");\n    const seen = new Set(); for (const e of g.edges) { const from = g.nodes.find(n => n.id === e.from); if (!from || !ids.has(e.to)) error(\"A connection points to a missing node.\"); else if (!ports(from).includes(e.port || \"main\")) error(\"Unknown output port: \" + e.port, e.from); const key = [e.from, e.to, e.port, e.input].join(\":\"); if (seen.has(key)) error(\"Remove the duplicate connection.\", e.from); seen.add(key); if (e.to === triggers[0]?.id) error(\"A trigger cannot have incoming connections.\", e.to); }\n    const reached = new Set(), walk = id => { if (reached.has(id)) return; reached.add(id); g.edges.filter(e => e.from === id).forEach(e => walk(e.to)); }; if (triggers[0]) walk(triggers[0].id);\n    g.nodes.filter(n => !reached.has(n.id)).forEach(n => error(\"Connect this node to the trigger.\", n.id));\n    // Every cycle must pass through a bounded loop head. Removing loop heads must leave a DAG.\n    const loops = new Set(g.nodes.filter(n => n.type === \"loop\").map(n => n.id)), visiting = new Set(), done = new Set();\n    const cycle = id => { if (loops.has(id) || done.has(id)) return; if (visiting.has(id)) { error(\"Close cycles through a Loop node with a finite limit.\", id); return; } visiting.add(id); g.edges.filter(e => e.from === id).forEach(e => cycle(e.to)); visiting.delete(id); done.add(id); }; g.nodes.forEach(n => cycle(n.id));\n    for (const n of g.nodes) {\n      const c = n.config || {};\n      if (n.type === \"loop\" && (!Number.isInteger(c.maxIterations) || c.maxIterations < 1 || c.maxIterations > 50)) error(\"Choose a loop limit from 1 to 50.\", n.id);\n      if (n.type === \"sub_workflow\" && !c.workflowId) error(\"Choose a saved sub-workflow.\", n.id);\n      if (n.type === \"tool_call\" && (!c.connectionId || !c.operationId)) error(\"Choose a connected app and action.\", n.id);\n      if (n.type === \"agent\" && !c.prompt?.trim()) error(\"Tell this agent what to do.\", n.id);\n      if (n.type === \"http_request\" && !c.connectionId && !/^https:\\/\\//.test(c.url || \"\")) error(\"Use a public HTTPS endpoint or a saved API connection.\", n.id);\n      if (n.type === \"code\" && c.language !== \"javascript\") error(\"KAI Code nodes use isolated JavaScript; translate this script before enabling it.\", n.id);\n      if (n.type === \"trigger\" && ![\"manual\", \"schedule\", \"app_change\", \"source_change\", \"app_event\"].includes(c.kind)) error(\"Choose a supported trigger. Raw webhook listeners are not enabled.\", n.id);\n      if (n.type === \"trigger\" && [\"app_change\", \"source_change\"].includes(c.kind) && !(c.sourceId || c.connectionId && c.operationId)) error(\"Select the source or read action to watch.\", n.id);\n      if (n.type === \"trigger\" && c.kind === \"app_event\" && !(c.connectionId && c.triggerSlug)) error(\"Select the app account and event type.\", n.id);\n      if (n.type === \"switch\" && (!Array.isArray(c.cases) || c.cases.length > 12 || c.cases.some(p => !/^[a-zA-Z0-9_-]{1,40}$/.test(p) || [\"default\", \"error\"].includes(p)))) error(\"Use up to 12 unique case names (letters, numbers, dashes).\", n.id);\n      if (n.type === \"condition\" && !g.edges.some(e => e.from === n.id && e.port === \"false\")) warnings.push({ nodeId: n.id, message: \"Unmatched items stop here; connect False to handle them.\" });\n    }\n    return { errors, warnings };\n  }\n  function template(key, model = \"\", connection) {\n    const trigger = node(\"trigger\", \"start\", { x: 90, y: 60 }), nodes = [trigger], edges = [];\n    const add = (type, config, label) => { const n = node(type, \"n\" + nodes.length, { x: 90, y: 60 + nodes.length * 155 }, config, label); edges.push(edge(nodes.at(-1).id, n.id, nodes.at(-1).type === \"approval\" ? \"approved\" : \"main\")); nodes.push(n); return n; };\n    const ask = (prompt, label) => add(\"agent\", { prompt, model }, label);\n    let name;\n    if ([\"briefing\", \"review\", \"digest\"].includes(key)) { name = { briefing: \"Project briefing\", review: \"Weekly goal review\", digest: \"Daily digest to an app\" }[key]; add(\"memory\", { operation: \"search\", query: \"{{input}}\" }, \"Gather context\"); ask(\"Summarize these notes and identify useful next steps. Cite note titles.\\n{{previous}}\", \"Write a briefing\"); if (key === \"review\") add(\"memory\", { operation: \"remember\", title: \"Reviewed next steps\", value: \"{{previous}}\" }, \"Remember next steps\"); if (key === \"digest\") { trigger.config.kind = \"schedule\"; add(\"tool_call\", { connectionId: connection?.id || \"\", operationId: \"\", variables: {}, body: {} }, \"Send the reviewed digest\"); } }\n    else if ([\"api\", \"scrape\"].includes(key)) { name = key === \"api\" ? \"Fetch and parse an API\" : \"Scheduled source to Brain\"; add(\"http_request\", { url: \"https://api.example.com/data\" }, \"Call the API\"); add(\"output_parser\", { field: \"=item.text\", format: \"json\" }, \"Parse the response\"); if (key === \"scrape\") { trigger.config.kind = \"schedule\"; ask(\"Summarize this source:\\n{{previous}}\", \"Summarize source\"); add(\"memory\", { operation: \"remember\", title: \"Source summary\", value: \"{{previous}}\" }, \"Save to Brain\"); } }\n    else if (key === \"event\") { name = \"App change to conditional action\"; trigger.config = { ...trigger.config, kind: \"app_change\", connectionId: connection?.id || \"\", operationId: connection?.operations?.find(o => o.method === \"GET\")?.id || \"\", variables: {}, intervalMinutes: 5 }; ask(\"Classify this change and return JSON with a boolean relevant field and a short summary.\\n{{previous}}\", \"Triage the change\"); add(\"output_parser\", { format: \"json\", field: \"=item.text\" }); add(\"condition\", { expression: \"=item.relevant\" }, \"Is it relevant?\"); const out = node(\"output\", \"result\", { x: 90, y: 680 }, { text: \"{{previous}}\" }, \"Keep relevant result\"); edges.push(edge(nodes.at(-1).id, out.id, \"true\")); nodes.push(out); }\n    else if (key === \"research\") { name = \"Plan and write a research brief\"; add(\"memory\", { operation: \"search\", query: \"{{input}}\" }, \"Gather research\"); ask(\"Plan a concise research brief from these sources:\\n{{previous}}\", \"Plan the brief\"); ask(\"Write the brief from this plan. Clearly mark unknowns.\\n{{previous}}\", \"Draft the brief\"); }\n    else if (key === \"loop\") { name = \"Review and refine\"; ask(\"Draft a short answer to {{input}}\", \"First draft\"); const loop = add(\"loop\", { maxIterations: 2, onExceeded: \"continue\" }, \"Refine twice\"), refine = node(\"agent\", \"refine\", { x: 420, y: 390 }, { model, prompt: \"Improve this draft, keeping it concise:\\n{{previous}}\" }, \"Refine draft\"); nodes.push(refine); edges.push(edge(loop.id, refine.id, \"body\"), edge(refine.id, loop.id)); const out = node(\"output\", \"result\", { x: 90, y: 560 }); nodes.push(out); edges.push(edge(loop.id, out.id, \"done\")); }\n    else { name = \"Ask KAI\"; ask(\"{{input}}\", \"Ask the agent\"); }\n    if (!nodes.some(n => n.type === \"output\") && nodes.at(-1).type !== \"memory\") add(\"output\", { text: \"{{previous}}\" }, \"Keep the result\");\n    return { name, model, enabled: false, description: \"\", graph: { version: 2, nodes, edges } };\n  }\n  const templates = [[\"briefing\", \"Project briefing\", \"Search your Brain and prepare a useful briefing.\"], [\"review\", \"Weekly goal review\", \"Review context and remember approved next steps.\"], [\"digest\", \"Daily digest to an app\", \"Summarize context on a schedule and send it to a connection.\"], [\"scrape\", \"Scheduled source to Brain\", \"Read a source, summarize it, and remember the reviewed result.\"], [\"event\", \"App change to conditional action\", \"Watch a read action, triage changes, and follow a branch.\"], [\"api\", \"Fetch and parse an API\", \"Read structured data and use it in later steps.\"], [\"ask\", \"Ask KAI\", \"A simple manual prompt with a saved result.\"], [\"research\", \"Plan and write a research brief\", \"Use separate agents and models to plan and draft.\"], [\"loop\", \"Review and refine\", \"Improve a draft through a bounded feedback loop.\"]];\n  return { catalog, types, meta, defaults, node, edge, ports, fromLegacy, importDocument, validateGraph, template, templates, clone };\n});\n","workflows.css":"/* Flush section navigation, shared by Brain, Workflows and Connections. */\n.view.companion-hub{max-width:none;margin:0;padding:0;width:100%}\n.companion-hub>.hub-notice:empty{display:none}.companion-hub>.hub-notice:not(:empty){margin:12px 20px}\n.companion-hub .hub-shell{grid-template-columns:170px minmax(0,1fr);gap:0;min-height:100%}\n.companion-hub .hub-rail{top:0;gap:3px;padding:20px 10px 24px 12px;border-right:1px solid var(--border);min-height:calc(100vh - 135px);background:var(--bg-raised)}\n.companion-hub .hub-rail-label{padding:3px 8px 15px;font-size:9px;letter-spacing:.09em}\n.companion-hub .hub-rail button{padding:10px 9px;min-height:37px;font-size:12px;line-height:1.4;border-radius:7px;text-align:left;box-shadow:none;white-space:normal}\n.companion-hub .hub-rail button.active{color:var(--violet);background:var(--violet-soft,#eef3ff);box-shadow:none;font-weight:600}\n.companion-hub .hub-rail button:hover{color:var(--text);background:var(--bg)}\n.companion-hub .hub-content{padding:26px 26px 50px;min-width:0}\n.companion-hub .hub-shell:has(.wf-builder){grid-template-columns:minmax(0,1fr)}\n.companion-hub .hub-shell:has(.wf-builder)>.hub-rail{display:none}\n.companion-hub .hub-shell:has(.wf-builder)>.hub-content{padding:0}\n.wf-workspace{min-width:0;color:var(--text);font-size:13px}.wf-workspace *{box-sizing:border-box}\n.wf-workspace button{appearance:none;border:1px solid var(--border);background:var(--bg-raised);color:var(--text);border-radius:8px;padding:8px 12px;font:inherit;line-height:1.4;cursor:pointer;box-shadow:none}\n.wf-workspace button:hover{border-color:var(--violet);color:var(--violet)}.wf-workspace button:focus-visible,.wf-node:focus-visible{outline:2px solid var(--violet);outline-offset:3px}.wf-workspace button:disabled{opacity:.45;cursor:default}\n.wf-workspace button.primary{color:#fff;background:var(--violet);border-color:var(--violet)}.wf-workspace button.active{border-color:var(--violet);color:var(--violet);background:var(--violet-soft,#eef3ff)}\n.wf-notice{font-size:12px;line-height:1.6;color:var(--text-dim);padding:10px 0}.wf-notice:empty{display:none}.wf-builder>.wf-notice{padding:10px 20px;background:var(--bg-raised);border-bottom:1px solid var(--border)}\n.wf-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}.wf-heading h2{font-size:24px;line-height:1.2;letter-spacing:-.035em;margin:0 0 9px}.wf-heading p{color:var(--text-dim);line-height:1.7;max-width:560px;margin:0}.wf-heading .hub-actions{margin:0}\n.wf-prompt-bar{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--bg-raised);border:1px solid var(--border);border-radius:12px;margin-bottom:25px;box-shadow:0 4px 20px #26356505}.wf-prompt-bar input{flex:1;border:0!important;background:transparent!important;padding:4px!important}.wf-spark{color:var(--violet);font-size:26px}.wf-prompt-bar button{flex-shrink:0;font-size:12px}\n.wf-list-tools{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:14px}.wf-list-tools input{max-width:300px}.wf-list-tools>span{color:var(--text-dim);font-size:11px;white-space:nowrap}\n.wf-saved-list{display:grid;gap:12px}.wf-saved{display:flex;align-items:center;gap:15px;background:var(--bg-raised);border:1px solid var(--border);border-radius:12px;padding:20px}.wf-flow-icon{display:grid;place-items:center;width:42px;height:42px;flex:none;background:var(--violet-soft,#eef3ff);color:var(--violet);font-size:25px;border-radius:11px}.wf-saved-info{min-width:0;flex:1}.wf-workspace .wf-name{border:0;padding:0;background:transparent;text-align:left;font-weight:650;font-size:15px}.wf-saved-info p{font-size:12px;color:var(--text-dim);line-height:1.6;margin:7px 0;overflow-wrap:anywhere}.wf-saved-info small{font-size:10px;color:var(--text-dim);display:block;margin-top:7px}.wf-meta{display:flex;gap:8px 14px;flex-wrap:wrap;font-size:10px;color:var(--text-dim);align-items:center}\n.wf-row-actions{display:flex;align-items:center;gap:9px}.wf-workspace .wf-toggle{border:0;background:#c8d2e4;width:33px;height:20px;padding:3px;border-radius:20px;flex:none}.wf-toggle span{display:block;width:14px;height:14px;border-radius:50%;background:white;box-shadow:0 1px 3px #0002}.wf-workspace .wf-toggle.on{background:var(--violet)}.wf-toggle.on span{margin-left:13px}\n.wf-menu{position:relative}.wf-menu>summary{cursor:pointer;list-style:none;padding:6px 8px;color:var(--text-dim)}.wf-menu>div{position:absolute;right:0;top:32px;min-width:145px;display:grid;padding:5px;border:1px solid var(--border);border-radius:9px;background:var(--bg-raised);z-index:15;box-shadow:0 12px 30px #15234018}.wf-menu button{border:0;text-align:left;font-size:12px}\n.wf-section-heading{display:flex;justify-content:space-between;gap:15px;align-items:center;margin:30px 0 14px}.wf-section-heading h3{font-size:15px;margin:0}.wf-section-heading button{font-size:11px;border:0;background:transparent;color:var(--violet)}\n.wf-templates{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.wf-workspace .wf-template{text-align:left;padding:21px;border-radius:12px;display:grid;grid-template-columns:34px 1fr;gap:9px 12px;align-content:start}.wf-template-icon{width:32px;height:32px;border-radius:8px;color:var(--violet);background:var(--violet-soft,#eef3ff);display:grid;place-items:center;font-size:21px;grid-row:1/3}.wf-template strong{font-size:14px;line-height:1.6}.wf-template p{margin:0;font-size:12px;color:var(--text-dim);line-height:1.7}.wf-template small{grid-column:2;color:var(--violet);font-size:11px;margin-top:6px}\n.wf-field{display:flex;flex-direction:column;gap:7px;font-size:12px;margin:0 0 16px;min-width:0}.wf-field>span{font-weight:550;color:var(--text-dim)}.wf-field small{font-size:10px;line-height:1.6;color:var(--text-dim);font-weight:normal}.wf-workspace input,.wf-workspace select,.wf-workspace textarea{background:var(--bg-raised)!important;font-size:12px!important;padding:9px 10px!important;min-width:0;max-width:100%}.wf-workspace textarea[data-format=json],.wf-workspace textarea[data-format=code],#wf-document{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;line-height:1.7;font-size:11px!important}.wf-check{display:flex;align-items:flex-start;gap:9px;margin:13px 0;font-size:12px;line-height:1.6}.wf-check input[type=checkbox]{width:15px!important;height:15px!important;flex:none;margin:2px 0 0;padding:0!important;accent-color:var(--violet)}.wf-field-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.wf-workspace fieldset{margin:0;padding:0;border:0;min-width:0}\n.wf-run-filters{display:grid;grid-template-columns:2fr 1fr;gap:15px;margin-bottom:14px}.wf-run .hub-badge{font-size:10px}.wf-run-step>summary{display:flex;align-items:center;gap:8px;cursor:pointer;flex-wrap:wrap}.wf-run-step summary small{margin:0 0 0 auto}.wf-run-step>b{font-size:11px;display:block;margin:12px 0 4px}.wf-step-status{color:var(--text-dim);font-size:15px}.wf-step-status.completed{color:#149678}.wf-step-status.failed{color:var(--danger)}.wf-discover-form{border:1px solid var(--border);border-radius:12px;padding:22px;background:var(--bg-raised);margin-bottom:22px}.wf-discover-form>.wf-field{max-width:350px}\n.wf-builder-header{display:flex;align-items:center;gap:15px;padding:18px 20px;background:var(--bg-raised);border-bottom:1px solid var(--border)}.wf-builder-title{min-width:0;flex:1}.wf-builder-title h2{font-size:18px;margin:0 0 5px;overflow-wrap:anywhere}.wf-builder-title small{font-size:10px;color:var(--text-dim)}.wf-builder-actions{display:flex;gap:8px;flex-wrap:wrap}.wf-builder-actions button{font-size:11px}.wf-builder-tools{padding:9px 18px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;border-bottom:1px solid var(--border);background:var(--bg-raised)}.wf-builder-tools>div{display:flex;gap:6px}.wf-builder-tools button{font-size:10px;padding:6px 9px;border-color:transparent;background:transparent}.wf-canvas-hint,.wf-validation{padding:10px 20px;font-size:10px;line-height:1.6;background:var(--bg-raised);border-bottom:1px solid var(--border);color:var(--text-dim)}\n.wf-builder-body{display:grid;grid-template-columns:148px minmax(220px,1fr) 270px;min-height:580px;height:calc(100vh - 285px);position:relative}\n.wf-palette{overflow:auto;padding:15px 10px;background:var(--bg-raised);border-right:1px solid var(--border)}.wf-palette input{font-size:10px!important;padding:7px!important}.wf-palette-group h3{font-size:9px;text-transform:uppercase;letter-spacing:.07em;color:var(--text-dim);margin:20px 6px 9px}.wf-palette-group button{display:flex;align-items:center;gap:8px;width:100%;margin:4px 0;padding:8px 6px;text-align:left;border:0;font-size:11px}.wf-palette-group button>span{width:22px;height:22px;display:grid;place-items:center;border-radius:6px;background:var(--bg);color:var(--violet);font-size:14px;flex:none}\n.wf-viewport{position:relative;overflow:hidden;min-width:0;min-height:500px;background-color:var(--bg);background-image:radial-gradient(var(--border) 1px,transparent 1px);background-size:20px 20px;touch-action:none;outline:none}.wf-stage{position:absolute;inset:0;transform-origin:0 0;will-change:transform}.wf-edges{width:7000px;height:14000px;position:absolute;top:0;left:0;overflow:visible;pointer-events:none}.wf-edge{pointer-events:all;cursor:pointer}.wf-edge path{stroke:#91a4c6;stroke-width:2;fill:none}.wf-edge .wf-edge-hit{stroke:transparent;stroke-width:14}.wf-edge:hover path:not(.wf-edge-hit){stroke:var(--violet);stroke-width:3}.wf-edge text{font-size:10px;fill:var(--text-dim);paint-order:stroke;stroke:var(--bg);stroke-width:5px;stroke-linejoin:round}\n.wf-node{position:absolute;width:250px;min-height:139px;background:var(--bg-raised);border:1px solid var(--border);border-radius:12px;box-shadow:0 4px 12px #1629460d;user-select:none}.wf-node.selected{border:2px solid var(--violet);box-shadow:0 0 0 3px #4778ef15}.wf-node.completed{border-color:#24a88d}.wf-node.waiting{border-color:#d99936}.wf-node.failed{border-color:var(--danger)}.wf-node-heading{display:flex;gap:10px;align-items:center;padding:15px 15px 11px;cursor:grab;touch-action:none}.wf-node-heading:active{cursor:grabbing}.wf-node-icon{display:grid;place-items:center;width:31px;height:31px;border-radius:9px;background:var(--violet-soft,#eef3ff);color:var(--violet);font-size:19px;flex:none}.wf-node-icon.type-trigger{color:#cf810e;background:#fff4d9}.wf-node-icon.type-condition,.wf-node-icon.type-switch{color:#e17848;background:#fff0e9}.wf-node-icon.type-loop,.wf-node-icon.type-merge{color:#148b73;background:#e7f7f0}.wf-node-heading strong{display:block;font-size:13px;line-height:1.4;max-width:174px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.wf-node-heading small{display:block;font-size:9px;color:var(--text-dim);margin-top:4px}.wf-node>p{font-size:10px;color:var(--text-dim);line-height:1.5;margin:0 15px 8px;max-height:30px;overflow:hidden;overflow-wrap:anywhere}.wf-output-ports{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:2px;padding:0 8px 8px}.wf-output-ports button{display:flex;align-items:center;gap:6px;font-size:9px!important;border:0!important;padding:3px 5px!important;background:transparent!important}.wf-output-ports i{display:inline-block;width:9px;height:9px;background:var(--violet);border:2px solid var(--bg-raised);box-shadow:0 0 0 1px var(--violet);border-radius:50%}.wf-node .wf-input-port{min-height:11px;min-width:11px;position:absolute;left:-6px;top:48px;padding:0;width:11px;height:11px;border:2px solid var(--bg-raised);border-radius:50%;background:var(--violet);box-shadow:0 0 0 1px var(--violet)}\n.wf-canvas-controls{position:absolute;bottom:15px;left:15px;display:flex;align-items:center;gap:5px;padding:4px;border:1px solid var(--border);border-radius:9px;background:var(--bg-raised);box-shadow:0 3px 9px #1629460c;z-index:3}.wf-canvas-controls button{padding:5px 10px;border:0;font-size:12px}.wf-canvas-controls>span{font-size:10px;color:var(--text-dim);min-width:32px;text-align:center}\n.wf-inspector{padding:20px 17px;background:var(--bg-raised);border-left:1px solid var(--border);overflow:auto;min-width:0}.wf-inspector h3{font-size:15px;margin:0 0 20px}.wf-inspector h4{font-size:12px;margin:20px 0 12px}.wf-inspector-heading{display:flex;gap:10px;align-items:center;margin-bottom:23px}.wf-inspector-heading h3{margin:0}.wf-inspector details{font-size:11px;line-height:1.6;border-top:1px solid var(--border);padding-top:12px;margin:18px 0}.wf-inspector details>summary{cursor:pointer;color:var(--text-dim);font-weight:550;margin-bottom:12px}.wf-inspector .hub-help{font-size:11px}.wf-inspector .hub-actions{gap:7px}.wf-inspector .hub-actions button{font-size:10px;padding:7px 9px}.wf-edge-list>div{display:flex;gap:5px;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border);font-size:10px;overflow-wrap:anywhere}.wf-edge-list button{border:0;padding:3px 7px}.wf-edge-form{margin-top:18px}.wf-workspace .wf-expression{font-family:monospace;border:0;background:var(--bg);font-size:10px;display:block;width:100%;text-align:left;margin:5px 0;overflow-wrap:anywhere}.wf-run-link{display:block;width:100%;text-align:left;margin:8px 0}.wf-run-link small{display:block;font-size:9px;margin-top:5px;color:var(--text-dim)}.wf-inspector .wf-run{padding:12px;margin-top:15px}.wf-inspector .wf-run>summary{font-size:11px;flex-wrap:wrap}.wf-proposal{padding:14px;border:1px solid var(--border);border-radius:10px;margin-top:20px}.wf-proposal p{font-size:11px;line-height:1.6}.wf-proposal button{font-size:10px;margin:6px 5px 0 0}.wf-running-strip{padding:12px 20px;border-top:1px solid var(--border);display:flex;align-items:center;gap:12px;background:var(--bg-raised);font-size:12px}.wf-running-strip span{flex:1}\n.wf-modal-backdrop{position:fixed;inset:0;background:#11254766;z-index:90;display:grid;place-items:center;padding:25px}.wf-modal{width:min(540px,100%);max-height:90vh;overflow:auto;background:var(--bg-raised);border:1px solid var(--border);border-radius:16px;padding:26px;box-shadow:0 25px 75px #10234333}.wf-modal .wf-heading{align-items:center;margin-bottom:15px}.wf-modal h3{margin:0;font-size:18px}\n@media(max-width:1200px){.wf-builder-body{grid-template-columns:minmax(240px,1fr) 250px}.wf-palette{display:none;position:absolute;left:10px;top:10px;bottom:10px;width:175px;z-index:12;box-shadow:0 8px 30px #142d501c;border:1px solid var(--border);border-radius:10px}.wf-palette.show{display:block}.companion-hub .hub-content{padding:23px 20px 45px}.wf-saved{flex-wrap:wrap}.wf-row-actions{margin-left:auto}.wf-flow-icon{align-self:flex-start}}\n@media(max-width:960px){.companion-hub .hub-shell{grid-template-columns:145px minmax(0,1fr)}.companion-hub .hub-rail{padding-left:8px;padding-right:8px}.companion-hub .hub-rail button{font-size:11px;padding:10px 8px}.companion-hub .hub-content{padding:20px 16px 40px}.wf-templates{grid-template-columns:1fr}.wf-list-tools{flex-wrap:wrap;gap:10px}.wf-list-tools input{max-width:none}.wf-heading h2{font-size:21px}.wf-prompt-bar{flex-wrap:wrap}.wf-prompt-bar input{min-width:150px!important}.wf-prompt-bar button{margin-left:auto}.wf-builder-header{flex-wrap:wrap;padding:14px}.wf-builder-title{flex-basis:50%}.wf-builder-actions{width:100%;justify-content:flex-end}.wf-builder-body{grid-template-columns:minmax(0,1fr);height:auto;min-height:0}.wf-viewport{height:500px;min-height:400px}.wf-inspector{border-left:0;border-top:1px solid var(--border);max-height:500px;display:block}.wf-inspector .wf-field{max-width:650px}.wf-palette{bottom:auto;max-height:460px}.wf-builder-tools{padding:9px 12px}.wf-canvas-hint,.wf-validation{padding:10px 14px}}\n@media(max-width:740px){.companion-hub .hub-shell{grid-template-columns:124px minmax(0,1fr)}.companion-hub .hub-rail{padding:16px 5px 20px 7px}.companion-hub .hub-rail-label{font-size:8px;padding:2px 6px 13px}.companion-hub .hub-rail button{font-size:10px;padding:9px 7px}.companion-hub .hub-content{padding:18px 12px 35px}.wf-saved{padding:14px;gap:10px}.wf-saved-info{flex-basis:calc(100% - 55px)}.wf-saved .wf-row-actions{width:100%;justify-content:flex-end}.wf-heading{gap:13px}.wf-heading h2{font-size:19px}.wf-heading p{font-size:12px}.wf-run-filters{grid-template-columns:1fr;gap:0}.wf-section-heading{align-items:flex-start;flex-wrap:wrap}.wf-builder-header>button{padding:6px 8px}.wf-builder-title h2{font-size:16px}.wf-builder-actions button{padding:7px 9px}.wf-viewport{height:430px}.wf-modal-backdrop{padding:15px}.wf-modal{padding:20px}.wf-running-strip{flex-wrap:wrap}}\n\n/* Keep each catalog filter label beside its own control. */\n.companion-hub .cn-categories .cn-category-picker{display:flex;flex-direction:column;align-items:flex-start;gap:7px;min-width:180px;max-width:280px;flex:1}.companion-hub .cn-category-picker select{width:100%;min-width:0}\n","workflows.js":"\"use strict\";\n(() => {\n  const M = window.KaiWorkflowModel, esc = s => String(s ?? \"\").replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" })[c]);\n  const date = n => n ? new Date(n).toLocaleString([], { dateStyle: \"medium\", timeStyle: \"short\" }) : \"Never\";\n  const btn = (label, action, id = \"\", cls = \"\") => KaiI18n.html`<button type=\"button\" class=\"${cls}\" data-wf=\"${action}\" data-id=\"${esc(id)}\" data-i18n=\"${esc(label)}\">${esc(label)}</button>`;\n  const select = (path, label, values, value) => KaiI18n.html`<label class=\"wf-field\"><span>${esc(label)}</span><select data-field=\"${esc(path)}\">${values.map(v => { const [key, text] = Array.isArray(v) ? v : [v, v]; return KaiI18n.html`<option value=\"${esc(key)}\" ${String(key) === String(value) ? \"selected\" : \"\"}>${esc(text)}</option>`; }).join(\"\")}</select></label>`;\n  const field = (path, label, value = \"\", kind = \"text\", hint = \"\") => KaiI18n.html`<label class=\"wf-field\"><span>${esc(label)}</span>${[\"area\", \"json\", \"code\"].includes(kind) ? KaiI18n.html`<textarea rows=\"${kind === \"code\" ? 9 : 4}\" data-field=\"${esc(path)}\" data-format=\"${kind}\" spellcheck=\"${kind === \"area\"}\">${esc(kind === \"json\" ? JSON.stringify(value, null, 2) : value)}</textarea>` : KaiI18n.html`<input type=\"${kind === \"number\" ? \"number\" : \"text\"}\" data-field=\"${esc(path)}\" data-format=\"${kind}\" value=\"${esc(value)}\"/>`}${hint ? KaiI18n.html`<small>${hint}</small>` : \"\"}</label>`;\n  const check = (path, label, value) => KaiI18n.html`<label class=\"wf-check\"><input type=\"checkbox\" data-field=\"${esc(path)}\" data-format=\"bool\" ${value ? \"checked\" : \"\"}/><span>${esc(label)}</span></label>`;\n  const empty = (title, detail) => KaiI18n.html`<div class=\"hub-empty\"><strong data-i18n=\"${esc(title)}\">${title}</strong><p data-i18n=\"${esc(detail)}\">${detail}</p></div>`;\n  let host, api, data, section, draft = null, savedJSON = \"\", selected = \"\", inspector = \"node\", undo = [], redo = [], zoom = .85, pan = { x: 25, y: 10 }, linking = null, filter = \"\", runFilter = \"\", runStatus = \"\", runId = \"\", modal = null, proposal = null, busy = false, timer, invalid = \"\", copied = null;\n  const eventChoices = {};\n  const clone = M.clone, currentNode = () => draft?.graph.nodes.find(n => n.id === selected), dirty = () => draft && JSON.stringify(draft) !== savedJSON;\n  function notice(text, error = false) { const el = host?.querySelector(\".wf-notice\"); if (el) { el.textContent = text; el.classList.toggle(\"error\", error); } }\n  async function refresh() { data = await api.manage(\"status\"); }\n  function history() { undo.push(clone(draft)); if (undo.length > 50) undo.shift(); redo = []; }\n  function commit(fn) { history(); fn(); invalid = \"\"; draw(); }\n  function open(item) { draft = M.fromLegacy(item); savedJSON = JSON.stringify(draft); selected = draft.graph.nodes[0]?.id || \"\"; undo = []; redo = []; proposal = null; inspector = \"node\"; zoom = .85; pan = { x: 25, y: 10 }; runId = \"\"; draw(); }\n  function newFlow() { const trigger = M.node(\"trigger\", \"start\", { x: 80, y: 70 }); open({ name: \"New workflow\", description: \"\", model: data.models[0]?.alias || \"\", enabled: false, graph: { version: 2, nodes: [trigger], edges: [] } }); }\n  function render(out, options) { clearTimeout(timer); host = out; api = options; data = options.state; section = options.section; draw(); poll(); }\n  function draw() {\n    if (!host) return;\n    // Replacing a focused field can synchronously dispatch change/blur. Its\n    // input is already in the draft; detach delegates to prevent nested draws.\n    host.onchange = null; host.oninput = null;\n    host.innerHTML = KaiI18n.html`<div class=\"wf-workspace ${draft ? \"wf-builder\" : \"\"}\"><div class=\"wf-notice\" role=\"status\" aria-live=\"polite\"></div>${!draft && data.workflowState?.eventRelay?.error ? KaiI18n.html`<div class=\"hub-pending\"><b>Live app events need attention</b><p>${esc(data.workflowState.eventRelay.error)}</p></div>` : \"\"}${draft ? builder() : section === \"runs\" ? runs() : section === \"discover\" ? discoveries() : section === \"templates\" ? templateCards() : saved()}${modal ? modalHTML() : \"\"}</div>`;\n    host.onclick = click; host.onchange = change; host.oninput = input; host.onsubmit = submit; host.onkeydown = keydown; host.onpointerdown = pointerdown;\n    const viewport = host.querySelector(\".wf-viewport\"); if (viewport) viewport.addEventListener(\"wheel\", wheel, { passive: false });\n    if (draft) paint();\n  }\n  function saved() {\n    const workflows = data.workflows.filter(w => (w.name + \" \" + w.description).toLowerCase().includes(filter.toLowerCase()));\n    return KaiI18n.html`<div class=\"wf-heading\"><div><h2>Your routines, connected</h2><p>Build a flow once. Run it when you need it, on a schedule, or when something changes.</p></div><div class=\"hub-actions\">${btn(\"Import\", \"import\")}${btn(\"New workflow\", \"new\", \"\", \"primary\")}</div></div><div class=\"wf-prompt-bar\"><span class=\"wf-spark\">✦</span><input id=\"wf-quick-prompt\" placeholder=\"Describe a routine you'd like KAI to build…\" aria-label=\"Describe a workflow\"/>${btn(\"Build with KAI\", \"quickBuild\")}</div><div class=\"wf-list-tools\"><input id=\"wf-filter\" aria-label=\"Search workflows\" placeholder=\"Search workflows\" value=\"${esc(filter)}\"/><span>${data.workflows.length} saved · ${data.workflows.filter(w => w.enabled).length} enabled</span></div><div class=\"wf-saved-list\">${workflows.map(w => { const last = data.runs.find(r => r.workflowId === w.id), graph = M.fromLegacy(w).graph, t = graph.nodes.find(n => n.type === \"trigger\")?.config; return KaiI18n.html`<article class=\"wf-saved\"><div class=\"wf-flow-icon\">⑂</div><div class=\"wf-saved-info\"><button data-wf=\"edit\" data-id=\"${esc(w.id)}\" class=\"wf-name\">${esc(w.name)}</button><p>${esc(w.description || graph.nodes.filter(n => n.type !== \"trigger\").map(n => n.label).slice(0, 4).join(\" → \"))}</p><div class=\"wf-meta\"><span>${graph.nodes.length} nodes</span><span>${esc(w.draft ? \"Draft · review needed\" : triggerLabel(t))}</span>${last ? KaiI18n.html`<span class=\"hub-badge ${esc(last.status)}\">${esc(last.status)}</span><span>${date(last.startedAt)}</span>` : KaiI18n.html`<span>Never run</span>`}</div>${w.nextRunAt ? KaiI18n.html`<small>Next run ${date(w.nextRunAt)}</small>` : \"\"}${w.watch?.error ? KaiI18n.html`<p class=\"error\">${esc(w.watch.error)}</p>` : \"\"}${w.legacyTask ? KaiI18n.html`<small>Moved from Tasks${w.legacyTask.needsModel ? \" · choose a local model\" : \"\"}${w.legacyTask.lastChatId ? \" · previous answers remain in Chat\" : \"\"}</small>` : \"\"}</div><div class=\"wf-row-actions\"><button data-wf=\"toggle\" data-id=\"${esc(w.id)}\" class=\"wf-toggle ${w.enabled ? \"on\" : \"\"}\" role=\"switch\" aria-checked=\"${!!w.enabled}\" aria-label=\"Enable ${esc(w.name)}\" ${w.draft ? \"disabled\" : \"\"}><span></span></button>${!w.draft ? btn(\"Run\", \"run\", w.id, \"primary\") : \"\"}<details class=\"wf-menu\"><summary aria-label=\"More actions for ${esc(w.name)}\">•••</summary><div>${btn(\"Open builder\", \"edit\", w.id)}${btn(\"Duplicate\", \"duplicate\", w.id)}${btn(\"Run history\", \"history\", w.id)}${btn(\"Export\", \"export\", w.id)}${btn(\"Delete\", \"delete\", w.id)}</div></details></div></article>`; }).join(\"\") || empty(\"Make room for the work you enjoy\", \"Start from a template or build your own flow.\")}</div><div class=\"wf-section-heading\"><h3>Start from a template</h3>${btn(\"View all templates\", \"templates\")}</div>${templateCards(true)}`;\n  }\n  function triggerLabel(c = {}) { return { manual: \"On demand\", schedule: \"Scheduled\", source_change: \"Source changes\", app_change: \"App changes\", app_event: \"App events\" }[c.kind] || \"On demand\"; }\n  function templateCards(compact = false) { return KaiI18n.html`${compact ? \"\" : KaiI18n.html`<div class=\"wf-heading\"><div><h2>A useful place to start</h2><p>Every template opens in the builder so you can choose models, apps, and the steps you want.</p></div></div>`}<div class=\"wf-templates\">${M.templates.slice(0, compact ? 4 : undefined).map(([key, name, detail]) => KaiI18n.html`<button type=\"button\" class=\"wf-template\" data-wf=\"template\" data-id=\"${key}\"><span class=\"wf-template-icon\">${key === \"loop\" ? \"↻\" : key === \"event\" ? \"⚡\" : \"⑂\"}</span><strong>${name}</strong><p>${detail}</p><small>Use template →</small></button>`).join(\"\")}</div>`; }\n  function runs() {\n    const list = data.runs.filter(r => (!runFilter || r.workflowId === runFilter) && (!runStatus || r.status === runStatus));\n    return KaiI18n.html`<div class=\"wf-heading\"><div><h2>Every run, step by step</h2><p>Inspect inputs, results, timings, and decisions. Paused runs wait here for you.</p></div></div><div class=\"wf-run-filters\">${select(\"runWorkflow\", \"Workflow\", [[\"\", \"All workflows\"], ...data.workflows.map(w => [w.id, w.name])], runFilter)}${select(\"runStatus\", \"Status\", [[\"\", \"All statuses\"], \"running\", \"waiting\", \"completed\", \"failed\", \"interrupted\", \"cancelled\"], runStatus)}</div><div class=\"hub-run-list\">${list.map(runCard).join(\"\") || empty(\"No runs here yet\", \"Run a saved workflow to see its progress and results.\")}</div>`;\n  }\n  function runCard(r) { return KaiI18n.html`<details class=\"hub-card hub-run wf-run\" data-run=\"${esc(r.id)}\" ${[\"waiting\", \"running\", \"interrupted\"].includes(r.status) ? \"open\" : \"\"}><summary><span><b>${esc(r.name)}</b><small>${date(r.startedAt)} · ${esc(r.trigger)}${r.dryRun ? \" · simulated preview\" : \"\"}</small></span><span class=\"hub-badge ${esc(r.status)}\">${esc(r.status)}</span></summary><div class=\"hub-run-body\"><div class=\"hub-actions\">${r.spec.graph ? btn(\"View on canvas\", \"runCanvas\", r.id) : \"\"}${[\"waiting\", \"interrupted\"].includes(r.status) && !r.inFlight ? btn(\"Review & resume\", \"resume\", r.id, \"primary\") : \"\"}${r.status === \"waiting\" ? btn(\"Reject\", \"reject\", r.id) : \"\"}${[\"running\", \"waiting\", \"interrupted\"].includes(r.status) ? btn(\"Cancel run\", \"cancel\", r.id) : btn(\"Run again\", \"run\", r.workflowId)}</div>${r.pending ? KaiI18n.html`<div class=\"hub-pending\"><b>Waiting for your decision</b><pre>${esc(JSON.stringify(r.pending, null, 2))}</pre></div>` : \"\"}${r.error ? KaiI18n.html`<p class=\"error\">${esc(r.error)}</p>` : \"\"}${r.steps.map((s, i) => KaiI18n.html`<details class=\"wf-run-step\"><summary><span class=\"wf-step-status ${esc(s.status)}\">${s.status === \"completed\" ? \"✓\" : s.status === \"running\" ? \"◌\" : \"!\"}</span>${i + 1}. ${esc(s.label)}<small>${esc(s.status)}${s.durationMs != null ? \" · \" + (s.durationMs / 1000).toFixed(1) + \"s\" : \"\"}${s.attempts > 1 ? \" · \" + s.attempts + \" attempts\" : \"\"}</small></summary>${s.frameId && s.frameId !== \"root\" ? KaiI18n.html`<p class=\"hub-help\">${esc(s.frameId)}</p>` : \"\"}${s.input ? KaiI18n.html`<b>Input</b><pre>${esc(JSON.stringify(s.input, null, 2))}</pre>` : \"\"}<b>Output</b><pre>${esc(s.error || s.output || \"Running…\")}</pre></details>`).join(\"\")}</div></details>`; }\n  function discoveries() { const suggestions = data.workflowState?.suggestions || [], settings = data.workflowState?.discovery || {}; return KaiI18n.html`<div class=\"wf-heading\"><div><h2>Discover useful routines</h2><p>KAI can suggest workflows from your goals, personal notes, and connected apps. You choose what to build.</p></div></div><form class=\"wf-discover-form\" data-wf-form=\"discover\">${select(\"discoverModel\", \"Local model\", [[\"\", \"Choose a model\"], ...data.models.map(m => [m.alias, m.label || m.alias])], data.models[0]?.alias)}${check(\"discoverBrain\", \"Use my personal Brain notes and goals for suggestions\", true)}<button class=\"primary\" ${busy ? \"disabled\" : \"\"}>${busy ? \"Finding ideas…\" : \"Find suggestions\"}</button></form><form class=\"wf-discover-form\" data-wf-form=\"discoverySettings\">${check(\"discoveryEnabled\", \"Suggest new routines automatically once a day\", settings.enabled)}${select(\"discoveryModel\", \"Local model for daily suggestions\", [[\"\", \"Choose a model\"], ...data.models.map(m => [m.alias, m.label || m.alias])], settings.model || data.models[0]?.alias)}${check(\"discoveryBrain\", \"Include my personal Brain notes and goals\", settings.includeBrain)}<button>Save suggestion settings</button><p class=\"hub-help\">Runs while KAI is open. Suggestions wait for your review and never enable a workflow automatically.${settings.lastAt ? \" Last checked: \" + date(settings.lastAt) : \"\"}</p>${settings.error ? KaiI18n.html`<p class=\"error\">${esc(settings.error)}</p>` : \"\"}</form><div class=\"wf-templates\">${suggestions.map(s => KaiI18n.html`<article class=\"hub-card\"><span class=\"hub-badge\">Suggested for you</span><h3>${esc(s.name)}</h3><p>${esc(s.request)}</p><p><b>Why:</b> ${esc(s.reason)}</p><div class=\"hub-actions\">${btn(\"Build this\", \"buildSuggestion\", s.id, \"primary\")}${btn(\"Dismiss\", \"dismiss\", s.id)}</div></article>`).join(\"\") || empty(\"Ideas start with your context\", \"Choose a local model and find suggestions. Nothing is saved or enabled until you review it.\")}</div>`; }\n  function builder() {\n    const report = M.validateGraph(draft.graph), last = data.runs.find(r => r.id === runId), readOnly = !!runId;\n    return KaiI18n.html`<div class=\"wf-builder-header\">${btn(\"← Back\", \"back\")}<div class=\"wf-builder-title\"><h2>${esc(draft.name)}</h2><small>${readOnly ? \"Run snapshot · \" + last?.status : dirty() ? \"Unsaved changes\" : draft.id ? \"Saved workflow\" : \"New workflow\"}</small></div><div class=\"wf-builder-actions\">${btn(\"Copilot\", \"inspector\", \"copilot\", inspector === \"copilot\" ? \"active\" : \"\")}${!readOnly ? btn(\"Settings\", \"inspector\", \"settings\") + btn(\"Save workflow\", \"save\", \"\", \"primary\") : \"\"}${draft.id && !draft.draft && !readOnly ? btn(\"Run\", \"run\", draft.id) : \"\"}</div></div><div class=\"wf-builder-tools\"><div>${btn(\"Undo\", \"undo\")}${btn(\"Redo\", \"redo\")}${btn(\"Add node\", \"palette\")}${btn(\"Auto arrange\", \"arrange\")}</div><div>${btn(\"Validate\", \"validate\")}${draft.id && !draft.draft ? btn(\"Preview\", \"preview\", draft.id) : \"\"}${btn(\"Run details\", \"inspector\", \"runs\")}</div></div>${report.errors.length || invalid ? KaiI18n.html`<div class=\"wf-validation error\">${esc(invalid || report.errors[0].message)}${report.errors.length > 1 ? ` (+${report.errors.length - 1} more)` : \"\"}</div>` : KaiI18n.html`<div class=\"wf-canvas-hint\">${linking ? \"Choose the input dot on the destination node. Escape cancels.\" : \"Drag nodes to arrange them. Connect an output to another node's input. Scroll to pan; Ctrl + scroll to zoom.\"}</div>`}<div class=\"wf-builder-body\"><aside class=\"wf-palette\" aria-label=\"Node library\"><input id=\"wf-node-search\" placeholder=\"Find a node\" aria-label=\"Find a node\"/>${[\"Start\", \"Actions\", \"Logic\", \"Finish\"].map(group => KaiI18n.html`<div class=\"wf-palette-group\"><h3>${group}</h3>${M.catalog.filter(n => n.group === group).map(n => KaiI18n.html`<button type=\"button\" data-wf=\"add\" data-id=\"${n.type}\" title=\"${esc(n.description)}\"><span>${n.icon}</span>${n.name}</button>`).join(\"\")}</div>`).join(\"\")}</aside><div class=\"wf-viewport\" tabindex=\"0\" role=\"region\" aria-label=\"Workflow canvas\"><div class=\"wf-stage\"><svg class=\"wf-edges\" aria-label=\"Node connections\"></svg><div class=\"wf-nodes\">${draft.graph.nodes.map(nodeHTML).join(\"\")}</div></div><div class=\"wf-canvas-controls\">${btn(\"−\", \"zoomOut\") }<span id=\"wf-zoom\">${Math.round(zoom * 100)}%</span>${btn(\"+\", \"zoomIn\")}${btn(\"Fit\", \"fit\")}</div></div><aside class=\"wf-inspector\" aria-label=\"Workflow inspector\">${inspectorHTML()}</aside></div>${last && [\"waiting\", \"running\", \"interrupted\"].includes(last.status) ? KaiI18n.html`<div class=\"wf-running-strip\"><span>${esc(last.name)} · ${esc(last.status)}</span>${last.status === \"waiting\" ? btn(\"Review & resume\", \"resume\", last.id, \"primary\") : \"\"}${btn(\"Cancel run\", \"cancel\", last.id)}</div>` : \"\"}`;\n  }\n  function nodeHTML(n) { const run = data.runs.find(r => r.id === runId), state = run?.frames?.root?.states?.[n.id]?.status || \"\", outputs = M.ports(n).filter(p => p !== \"error\" || n.config.onError === \"route\"); return KaiI18n.html`<article class=\"wf-node ${selected === n.id ? \"selected\" : \"\"} ${esc(state)}\" data-node=\"${esc(n.id)}\" tabindex=\"0\" aria-label=\"${esc(n.label)} node\"><button class=\"wf-input-port\" data-wf=\"connectTo\" data-id=\"${esc(n.id)}\" aria-label=\"Connect to ${esc(n.label)}\" title=\"Input\"></button><div class=\"wf-node-heading\" data-drag-node=\"${esc(n.id)}\"><span class=\"wf-node-icon type-${n.type}\">${M.meta(n.type)?.icon || \"◇\"}</span><div><strong>${esc(n.label)}</strong><small>${esc(M.meta(n.type)?.name || n.type)}${state ? \" · \" + state : \"\"}</small></div></div><p>${esc(summary(n))}</p><div class=\"wf-output-ports\">${outputs.map(p => KaiI18n.html`<button type=\"button\" data-wf=\"connectFrom\" data-id=\"${esc(n.id)}\" data-port=\"${esc(p)}\" aria-label=\"${esc(n.label)} ${esc(p)} output\">${esc(p)}<i></i></button>`).join(\"\")}</div></article>`; }\n  function summary(n) { const c = n.config; return (n.type === \"trigger\" ? triggerLabel(c) : n.type === \"agent\" ? c.prompt : n.type === \"tool_call\" ? data.connections.find(x => x.id === c.connectionId)?.name || \"Choose an app action\" : n.type === \"http_request\" ? (c.method || \"GET\") + \" \" + (c.connectionId ? \"Saved API connection\" : c.url) : n.type === \"memory\" ? c.operation + \" · \" + (c.query || c.title || \"Brain\") : n.type === \"loop\" ? \"Up to \" + c.maxIterations + \" iterations\" : n.type === \"sub_workflow\" ? data.workflows.find(w => w.id === c.workflowId)?.name || \"Choose a workflow\" : c.expression || c.text || c.source || M.meta(n.type)?.description || \"\").slice(0, 100); }\n  function inspectorHTML() {\n    if (inspector === \"copilot\") return KaiI18n.html`<h3>Build with KAI</h3><p class=\"hub-help\">Describe what you want to add or change. Review the proposed graph before applying it.</p><form data-wf-form=\"assist\">${select(\"assistModel\", \"Local model\", [[\"\", \"Choose a model\"], ...data.models.map(m => [m.alias, m.label || m.alias])], draft.model || data.models[0]?.alias)}${field(\"assistRequest\", \"What should this workflow do?\", \"\", \"area\")}<button class=\"primary\" ${busy || runId ? \"disabled\" : \"\"}>${busy ? \"Designing…\" : \"Suggest changes\"}</button></form>${proposal ? KaiI18n.html`<div class=\"wf-proposal\"><h4>${esc(proposal.proposal.name)}</h4><p>${esc(proposal.proposal.description)}</p><p>${proposal.proposal.graph.nodes.length} nodes · ${proposal.proposal.graph.edges.length} connections</p>${proposal.report.errors.map(e => KaiI18n.html`<p class=\"error\">${esc(e.message)}</p>`).join(\"\")}${btn(\"Apply to canvas\", \"applyProposal\", \"\", \"primary\")}${btn(\"Dismiss proposal\", \"dismissProposal\")}</div>` : \"\"}`;\n    if (inspector === \"settings\") return KaiI18n.html`<h3>Workflow settings</h3><fieldset ${runId ? \"disabled\" : \"\"}>${field(\"name\", \"Workflow name\", draft.name)}${field(\"description\", \"Purpose\", draft.description, \"area\")}${select(\"model\", \"Default local model\", [[\"\", \"Choose a model\"], ...data.models.map(m => [m.alias, m.label || m.alias])], draft.model)}${check(\"enabled\", \"Enable automatic triggers\", draft.enabled)}<p class=\"hub-help\">Schedules and watches run while KAI is open. App writes and Brain changes pause for your review.</p>${btn(\"Save as draft\", \"saveDraft\")}</fieldset><details><summary>Workflow JSON</summary><textarea id=\"wf-document\" rows=\"14\" spellcheck=\"false\">${esc(JSON.stringify(draft, null, 2))}</textarea>${!runId ? btn(\"Apply JSON\", \"applyJSON\") : \"\"}</details>`;\n    if (inspector === \"runs\") { const list = data.runs.filter(r => r.workflowId === draft.id).slice(0, 8); return KaiI18n.html`<h3>Recent runs</h3>${list.map(r => KaiI18n.html`<button class=\"wf-run-link\" data-wf=\"selectRun\" data-id=\"${esc(r.id)}\"><b>${esc(r.status)}</b><small>${date(r.startedAt)}</small></button>`).join(\"\") || KaiI18n.html`<p class=\"hub-help\">Save and run this workflow to inspect it here.</p>`}${runId ? runCard(data.runs.find(r => r.id === runId)) : \"\"}`; }\n    const n = currentNode(); if (!n) return KaiI18n.html`<h3>Choose a node</h3><p class=\"hub-help\">Select a node to edit its settings and see its connections.</p>`;\n    const c = n.config, f = (key, label, kind = \"text\", hint = \"\") => field(\"config.\" + key, label, c[key] ?? \"\", kind, hint), s = (key, label, choices) => select(\"config.\" + key, label, choices, c[key]), b = (key, label) => check(\"config.\" + key, label, c[key]);\n    let fields = \"\";\n    if (n.type === \"trigger\") {\n      fields += s(\"kind\", \"When to run\", [[\"manual\", \"On demand\"], [\"schedule\", \"On a schedule\"], [\"app_change\", \"When an app's data changes\"], [\"source_change\", \"When a Brain source changes\"], [\"app_event\", \"When an app event arrives\"]]);\n      if (c.kind === \"schedule\") { const v = c.schedule || {}, sf = (k, label, kind = \"text\") => field(\"config.schedule.\" + k, label, v[k] ?? \"\", kind); fields += select(\"config.schedule.kind\", \"Schedule\", [[\"hourly\", \"Every hour\"], [\"every6h\", \"Every 6 hours\"], [\"daily\", \"Daily\"], [\"weekly\", \"Weekly\"], [\"interval\", \"Custom interval\"], [\"at\", \"Once at a date/time\"], [\"cron\", \"Cron expression\"]], v.kind || \"daily\"); if ([\"daily\", \"weekly\"].includes(v.kind)) fields += KaiI18n.html`<div class=\"wf-field-pair\">${sf(\"hour\", \"Hour (0–23)\", \"number\")}${sf(\"minute\", \"Minute (0–59)\", \"number\")}</div>`; if (v.kind === \"weekly\") fields += select(\"config.schedule.day\", \"Day\", [[0, \"Sunday\"], [1, \"Monday\"], [2, \"Tuesday\"], [3, \"Wednesday\"], [4, \"Thursday\"], [5, \"Friday\"], [6, \"Saturday\"]], v.day ?? 1); if (v.kind === \"interval\") fields += sf(\"minutes\", \"Every N minutes\", \"number\"); if (v.kind === \"at\") fields += sf(\"at\", \"Date and time (ISO, with offset)\"); if (v.kind === \"cron\") fields += sf(\"expression\", \"Cron: minute hour day month weekday\"); if ([\"daily\", \"weekly\", \"cron\"].includes(v.kind)) fields += sf(\"timezone\", \"Time zone (blank = this computer)\"); }\n      if (c.kind === \"app_change\") fields += connectionFields(n, true);\n      if (c.kind === \"app_event\") { const schema = (eventChoices[c.connectionId] || []).find(t => t.slug === c.triggerSlug)?.config; fields += s(\"connectionId\", \"Connected app account\", [[\"\", \"Choose an app\"], ...data.connections.filter(x => x.provider === \"composio\" && x.enabled && x.allowSync).map(x => [x.id, x.name])]) + btn(\"Load available events\", \"loadEvents\", c.connectionId) + s(\"triggerSlug\", \"Event type\", [[\"\", \"Choose an event\"], ...(eventChoices[c.connectionId] || (c.triggerSlug ? [{slug:c.triggerSlug,name:c.triggerSlug}] : [])).map(x => [x.slug, x.name])]) + (schema?.properties ? Object.entries(schema.properties).map(([key, p]) => field(\"config.triggerConfig.\" + key, key.replace(/_/g, \" \") + ((schema.required || []).includes(key) ? \" *\" : \"\"), c.triggerConfig?.[key] ?? \"\", [\"object\", \"array\"].includes(p.type) ? \"json\" : [\"boolean\", \"number\", \"integer\"].includes(p.type) ? \"value\" : \"text\", esc(p.description || \"\"))).join(\"\") : f(\"triggerConfig\", \"Event settings (JSON)\", \"json\")) + KaiI18n.html`<p class=\"hub-help\">Enable the workflow to register this event. KAI uses your account server to receive signed events. Existing Composio webhook destinations are kept.</p>`; }\n      if (c.kind === \"source_change\") fields += s(\"sourceId\", \"Brain source\", [[\"\", \"Choose a source\"], ...data.sources.map(x => [x.id, x.name])]);\n      if ([\"app_change\", \"source_change\"].includes(c.kind)) fields += f(\"intervalMinutes\", \"Check every N minutes\", \"number\", \"The first check establishes a baseline; later changes start a run.\");\n      fields += KaiI18n.html`<details><summary>Run input fields</summary>${f(\"inputFields\", \"Fields (name, type, required)\", \"json\")}</details>`;\n    }\n    if (n.type === \"agent\") fields += s(\"profile\", \"Agent role\", [\"assistant\", \"planner\", \"researcher\", \"writer\", \"analyst\"]) + s(\"model\", \"Local model\", [[\"\", \"Use workflow default\"], ...data.models.map(m => [m.alias, m.label || m.alias])]) + f(\"prompt\", \"Instructions\", \"area\") + f(\"maxTurns\", \"Maximum turns\", \"number\") + KaiI18n.html`<details><summary>Selected read tools</summary><p class=\"hub-help\">Choose read actions from Connections. Outbound changes use separate App action nodes.</p>${data.connections.filter(x => x.enabled && x.allowSync).flatMap(conn => conn.operations.filter(o => o.method === \"GET\").map(o => KaiI18n.html`<label class=\"wf-check\"><input type=\"checkbox\" data-read-tool=\"${esc(conn.id)}\" data-operation=\"${esc(o.id)}\" ${(c.tools || []).some(t => t.connectionId === conn.id && t.operationId === o.id) ? \"checked\" : \"\"}/><span>${esc(conn.name)} · ${esc(o.name)}</span></label>`)).join(\"\") || \"No background read actions selected in Connections yet.\"}</details>`;\n    if (n.type === \"tool_call\") fields += connectionFields(n);\n    if (n.type === \"http_request\") { fields += s(\"connectionId\", \"Authentication\", [[\"\", \"Public endpoint (no credentials)\"], ...data.connections.filter(x => x.enabled && x.provider !== \"composio\").map(x => [x.id, x.name])]); if (c.connectionId) fields += connectionFields(n, false, true); else fields += s(\"method\", \"Method\", [\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"]) + f(\"url\", \"Endpoint URL\") + f(\"headers\", \"Headers (Accept / Content-Type)\", \"json\") + f(\"body\", \"Request body\", \"json\"); }\n    if (n.type === \"code\") fields += KaiI18n.html`<p class=\"hub-help\">JavaScript with <code>items</code>, <code>item</code>, <code>input</code>, and <code>nodes</code>. Return JSON data. Files and network are unavailable.</p>` + f(\"source\", \"JavaScript\", \"code\");\n    if (n.type === \"sub_workflow\") fields += s(\"workflowId\", \"Saved workflow\", [[\"\", \"Choose a workflow\"], ...data.workflows.filter(w => w.id !== draft.id && !w.draft).map(w => [w.id, w.name])]);\n    if (n.type === \"memory\") { fields += s(\"operation\", \"Brain action\", [[\"search\", \"Search memories\"], [\"recall\", \"Recall context\"], [\"people\", \"Find people\"], [\"goals\", \"Read active goals\"], [\"remember\", \"Remember (review first)\"], [\"forget\", \"Forget a note (review first)\"]]); if ([\"search\", \"recall\", \"people\"].includes(c.operation)) fields += f(\"query\", \"Search for\") + f(\"limit\", \"Maximum matches\", \"number\"); if (c.operation === \"remember\") fields += f(\"title\", \"Memory title\") + f(\"value\", \"What to remember\", \"area\"); if (c.operation === \"forget\") fields += s(\"noteId\", \"Personal note\", [[\"\", \"Choose a note\"], ...data.notes.filter(n => !n.sourceId).map(n => [n.id, n.title])]); }\n    if (n.type === \"approval\") fields += f(\"text\", \"What should be reviewed?\", \"area\") + KaiI18n.html`<p class=\"hub-help\">Connect Approved and Rejected outputs to the next steps.</p>`;\n    if (n.type === \"condition\") fields += f(\"expression\", \"Value or expression\") + s(\"operator\", \"Condition\", [[\"truthy\", \"Is true / has a value\"], [\"equals\", \"Equals\"], [\"contains\", \"Contains\"], [\"greater\", \"Greater than\"], [\"less\", \"Less than\"], [\"empty\", \"Is empty\"]]) + (![\"truthy\", \"empty\"].includes(c.operator) ? f(\"value\", \"Compare with\") : \"\");\n    if (n.type === \"switch\") fields += f(\"expression\", \"Route by expression\") + f(\"cases\", \"Case names (JSON array)\", \"json\");\n    if (n.type === \"merge\") fields += s(\"mode\", \"Combine branches\", [[\"append\", \"Append all items\"], [\"position\", \"Combine by position\"], [\"key\", \"Combine by matching key\"]]) + (c.mode === \"key\" ? f(\"key\", \"Matching field\") : \"\") + KaiI18n.html`<p class=\"hub-help\">Use distinct destination input names (A and B) for position or key merges.</p>`;\n    if (n.type === \"split_out\") fields += f(\"field\", \"Array expression\") + b(\"keepFields\", \"Keep the original item's fields\");\n    if (n.type === \"transform\") fields += f(\"set\", \"Field mapping (JSON)\", \"json\", 'For example: {\"title\":\"=item.json.title\"}') + b(\"keepFields\", \"Keep other fields\");\n    if (n.type === \"output_parser\") fields += s(\"format\", \"Output format\", [\"json\", \"text\", \"csv\"]) + f(\"field\", \"Value to parse\") + f(\"required\", \"Required fields (comma-separated)\");\n    if (n.type === \"dedup\") fields += f(\"key\", \"Stable item key\", \"text\", \"For example =item.id. Missing keys fail the node.\") + s(\"scope\", \"Remember seen items\", [[\"workflow\", \"Across workflow runs\"], [\"run\", \"Within this batch\"]]);\n    if (n.type === \"loop\") fields += f(\"maxIterations\", \"Maximum iterations (1–50)\", \"number\") + f(\"condition\", \"Continue while (optional expression)\") + s(\"onExceeded\", \"At the limit\", [[\"continue\", \"Continue through Done\"], [\"error\", \"Fail the run\"]]) + KaiI18n.html`<p class=\"hub-help\">Connect Body to the repeated steps, then connect their last output back to this loop's input.</p>`;\n    if (n.type === \"output\") fields += f(\"text\", \"Result\", \"area\") + b(\"saveChat\", \"Also save the answer in Chat history\");\n    if ([\"agent\", \"tool_call\", \"http_request\", \"memory\", \"sub_workflow\"].includes(n.type)) fields += s(\"execution\", \"Process input\", [[\"once\", \"Once for the whole input\"], [\"per_item\", \"Once for each item\"]]);\n    const edges = draft.graph.edges.filter(e => e.from === n.id || e.to === n.id);\n    return KaiI18n.html`<div class=\"wf-inspector-heading\"><span class=\"wf-node-icon\">${M.meta(n.type)?.icon}</span><h3>${esc(M.meta(n.type)?.name)}</h3></div><fieldset ${runId ? \"disabled\" : \"\"}>${field(\"label\", \"Node name\", n.label)}${fields}<details class=\"wf-advanced\"><summary>Errors, review & sample data</summary>${s(\"onError\", \"If this node fails\", [[\"stop\", \"Stop run\"], [\"continue\", \"Continue with error data\"], [\"route\", \"Follow Error output\"]])}${f(\"retries\", \"Read / compute retries (0–2)\", \"number\")}${f(\"timeoutSeconds\", \"Model timeout (5–180 seconds)\", \"number\")}${b(\"requireApproval\", \"Review before this node\")}${f(\"sampleOutput\", \"Simulated output for Preview\", \"json\")}</details><details class=\"wf-advanced\"><summary>Data from earlier nodes</summary><p class=\"hub-help\">Use =item.field, =item.json.field, =nodes.ID.text, or {{previous}}. Expressions use JavaScript.</p>${draft.graph.nodes.filter(x => x.id !== n.id).map(x => KaiI18n.html`<button type=\"button\" class=\"wf-expression\" data-wf=\"copyExpr\" data-id=\"${esc(x.id)}\">=nodes.${esc(x.id)}.text</button>`).join(\"\")}</details><h4>Connections</h4><div class=\"wf-edge-list\">${edges.map(e => KaiI18n.html`<div><span>${esc(e.from)} <b>${esc(e.port)}</b> → ${esc(e.to)} <small>${esc(e.input)}</small></span>${btn(\"×\", \"removeEdge\", e.id)}</div>`).join(\"\") || KaiI18n.html`<p class=\"hub-help\">Connect this node on the canvas.</p>`}</div><div class=\"wf-edge-form\">${select(\"linkPort\", \"Output\", M.ports(n), \"main\")}${select(\"linkTarget\", \"Next node\", [[\"\", \"Choose a node\"], ...draft.graph.nodes.filter(x => x.id !== n.id && x.type !== \"trigger\").map(x => [x.id, x.label])], \"\")}${field(\"linkInput\", \"Destination input\", \"main\")}${btn(\"Connect nodes\", \"addEdge\")}</div><div class=\"hub-actions\">${btn(\"Duplicate node\", \"duplicateNode\")}${n.type !== \"trigger\" ? btn(\"Delete node\", \"deleteNode\") : \"\"}</div></fieldset>`;\n  }\n  function connectionFields(n, read = false, hideConnection = false) {\n    const c = n.config, connections = data.connections.filter(x => x.enabled && (!read || x.allowSync)), conn = connections.find(x => x.id === c.connectionId), op = conn?.operations.find(o => o.id === c.operationId);\n    return `${!hideConnection ? select(\"config.connectionId\", \"Connected account\", [[\"\", \"Choose an account\"], ...connections.map(x => [x.id, x.name])], c.connectionId) : \"\"}${select(\"config.operationId\", \"Action\", [[\"\", \"Choose an action\"], ...(conn?.operations || []).filter(o => !read || o.method === \"GET\").map(o => [o.id, o.name + (o.method === \"GET\" ? \" · read\" : \" · review\")])], c.operationId)}${op?.schema ? Object.entries(op.schema.properties || {}).slice(0, 25).map(([key, p]) => field(\"config.variables.\" + key, key.replace(/_/g, \" \") + ((op.schema.required || []).includes(key) ? \" *\" : \"\"), c.variables?.[key] ?? (p.type === \"object\" ? {} : p.type === \"array\" ? [] : \"\"), [\"object\", \"array\"].includes(p.type) ? \"json\" : [\"number\", \"integer\", \"boolean\"].includes(p.type) ? \"value\" : \"text\", esc(String(p.description || \"\").slice(0, 180)))).join(\"\") : field(\"config.variables\", \"Path variables (JSON)\", c.variables || {}, \"json\")}${conn?.provider !== \"composio\" && op?.method !== \"GET\" ? field(\"config.body\", \"Request body (JSON)\", c.body || {}, \"json\") : \"\"}`;\n  }\n  function modalHTML() { const w = data.workflows.find(w => w.id === modal.id); return KaiI18n.html`<div class=\"wf-modal-backdrop\"><section class=\"wf-modal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Start workflow\"><div class=\"wf-heading\"><h3>${esc(w?.name || \"Start workflow\")}</h3><button type=\"button\" class=\"wf-dialog-close\" data-wf=\"closeModal\" aria-label=\"Close dialog\" title=\"Close\">×</button></div><form data-wf-form=\"run\"><label class=\"wf-field\"><span>Run input (optional)</span><textarea name=\"input\" rows=\"6\" placeholder=\"A topic, prompt, or JSON input\"></textarea></label>${(w?.graph?.nodes.find(n => n.type === \"trigger\")?.config.inputFields || []).length ? KaiI18n.html`<p class=\"hub-help\">Enter JSON with these fields: ${w.graph.nodes.find(n => n.type === \"trigger\").config.inputFields.map(f => esc(f.name + \" (\" + f.type + (f.required ? \", required\" : \"\") + \")\")).join(\", \")}</p>` : \"\"}<p class=\"hub-help\">${modal.preview ? \"Preview uses sample outputs for model, app, and memory nodes. No requests or changes are made.\" : \"Writes and Brain changes pause for your review.\"}</p><button class=\"primary\">${modal.preview ? \"Start preview\" : \"Start run\"}</button></form></section></div>`; }\n  function paint() {\n    const stage = host.querySelector(\".wf-stage\"); if (!stage || !draft) return;\n    // CSP forbids HTML style attributes. Set validated geometry through CSSOM.\n    for (const n of draft.graph.nodes) { const el = host.querySelector(`[data-node=\"${n.id}\"]`); if (el) { el.style.left = n.position.x + \"px\"; el.style.top = n.position.y + \"px\"; } }\n    stage.style.transform = `translate(${pan.x}px,${pan.y}px) scale(${zoom})`;\n    const svg = host.querySelector(\".wf-edges\"); svg.innerHTML = draft.graph.edges.map(e => {\n      const a = draft.graph.nodes.find(n => n.id === e.from), b = draft.graph.nodes.find(n => n.id === e.to); if (!a || !b) return \"\";\n      const origin = stage.getBoundingClientRect(), from = host.querySelector(`[data-wf=\"connectFrom\"][data-id=\"${a.id}\"][data-port=\"${e.port}\"] i`)?.getBoundingClientRect(), to = host.querySelector(`[data-wf=\"connectTo\"][data-id=\"${b.id}\"]`)?.getBoundingClientRect();\n      const x1 = from ? (from.x + from.width / 2 - origin.x) / zoom : a.position.x + 240, y1 = from ? (from.y + from.height / 2 - origin.y) / zoom : a.position.y + 112, x2 = to ? (to.x + to.width / 2 - origin.x) / zoom : b.position.x, y2 = to ? (to.y + to.height / 2 - origin.y) / zoom : b.position.y + 53;\n      const d = `M${x1},${y1} C${x1 + 70},${y1} ${x2 - 70},${y2} ${x2},${y2}`;\n      return KaiI18n.html`<g class=\"wf-edge\" data-wf=\"selectEdge\" data-id=\"${esc(e.id)}\"><path class=\"wf-edge-hit\" d=\"${d}\"/><path d=\"${d}\"/><text x=\"${(x1 + x2) / 2}\" y=\"${(y1 + y2) / 2 - 7}\">${esc(e.port === \"main\" ? \"\" : e.port)}</text></g>`;\n    }).join(\"\"); const label = host.querySelector(\"#wf-zoom\"); if (label) label.textContent = Math.round(zoom * 100) + \"%\";\n  }\n  function fit() { const rect = host.querySelector(\".wf-viewport\")?.getBoundingClientRect(); if (!rect || !draft.graph.nodes.length) return; const minX = Math.min(...draft.graph.nodes.map(n => n.position.x)), minY = Math.min(...draft.graph.nodes.map(n => n.position.y)), width = Math.max(...draft.graph.nodes.map(n => n.position.x + 260)) - minX, height = Math.max(...draft.graph.nodes.map(n => n.position.y + 140)) - minY; zoom = Math.max(.18, Math.min(1, (rect.width - 60) / width, (rect.height - 60) / height)); pan = { x: (rect.width - width * zoom) / 2 - minX * zoom, y: 25 - minY * zoom }; paint(); }\n  function setValue(target, path, value) { const parts = path.split(\".\"); for (const key of parts) if ([\"__proto__\", \"constructor\", \"prototype\"].includes(key)) throw Error(\"Unsupported field.\"); for (const key of parts.slice(0, -1)) { if (!target[key] || typeof target[key] !== \"object\") target[key] = {}; target = target[key]; } target[parts.at(-1)] = value; }\n  function readField(el) { return el.dataset.format === \"bool\" ? el.checked : el.dataset.format === \"number\" ? Number(el.value) : el.dataset.format === \"value\" ? (el.value.startsWith(\"=\") ? el.value : JSON.parse(el.value)) : el.dataset.format === \"json\" ? JSON.parse(el.value || \"null\") : el.value; }\n  function input(e) {\n    const el = e.target;\n    if (el.id === \"wf-filter\") { filter = el.value; const position = el.selectionStart; draw(); const input = host.querySelector(\"#wf-filter\"); input.focus(); input.setSelectionRange(position, position); return; }\n    if (el.id === \"wf-node-search\") { for (const b of host.querySelectorAll('[data-wf=\"add\"]')) b.hidden = !b.textContent.toLowerCase().includes(el.value.toLowerCase()); return; }\n    if (!el.dataset.field || !draft || runId || /^(assist|discover|link|run)/.test(el.dataset.field)) return;\n    try {\n      const path = el.dataset.field, target = inspector === \"settings\" ? draft : currentNode(); if (!target) return;\n      if (el.dataset.format === \"json\") readField(el); // Keep invalid JSON text available for correction.\n      if (!el.dataset.history) { history(); el.dataset.history = \"1\"; }\n      setValue(target, path, readField(el)); invalid = \"\"; const title = host.querySelector(\".wf-builder-title small\"); if (title) KaiI18n.setText(title, \"Unsaved changes\");\n    } catch { invalid = \"Enter valid JSON before saving this node.\"; notice(invalid, true); }\n  }\n  function change(e) {\n    const el = e.target;\n    if (el.dataset.field === \"runWorkflow\") { runFilter = el.value; draw(); return; } if (el.dataset.field === \"runStatus\") { runStatus = el.value; draw(); return; }\n    if (el.dataset.readTool && currentNode() && !runId) { history(); const tools = currentNode().config.tools ||= []; const key = el.dataset.readTool, op = el.dataset.operation; currentNode().config.tools = tools.filter(t => !(t.connectionId === key && t.operationId === op)); if (el.checked) currentNode().config.tools.push({ connectionId: key, operationId: op }); return; }\n    input(e);\n    if (!draft || runId || !el.dataset.field || /^(assist|discover|link|run)/.test(el.dataset.field)) return;\n    if ([\"config.connectionId\", \"config.operationId\"].includes(el.dataset.field)) { if (el.dataset.field === \"config.connectionId\") { currentNode().config.operationId = \"\"; delete currentNode().config.triggerId; delete currentNode().config.triggerSlug; } currentNode().config.variables = {}; }\n    if (el.dataset.field === \"config.kind\" && currentNode()?.type === \"trigger\") { currentNode().config.schedule ||= { kind: \"daily\", hour: 9, minute: 0, day: 1 }; currentNode().config.intervalMinutes ||= 5; }\n    if (el.dataset.field === \"config.schedule.kind\") { const s = currentNode().config.schedule; s.hour ??= 9; s.minute ??= 0; s.day ??= 1; s.minutes ??= 30; s.expression ||= \"0 9 * * 1-5\"; }\n    if (!invalid) { const scroll = host.querySelector(\".wf-inspector\")?.scrollTop || 0; draw(); host.querySelector(\".wf-inspector\").scrollTop = scroll; }\n  }\n  async function click(e) {\n    const button = e.target.closest(\"[data-wf]\");\n    if (!button) { const n = e.target.closest(\"[data-node]\"); if (n && !e.target.closest(\"input,textarea,select\")) { selected = n.dataset.node; inspector = \"node\"; draw(); } return; }\n    const action = button.dataset.wf, id = button.dataset.id; if (busy && ![\"cancel\", \"closeModal\"].includes(action)) return;\n    try {\n      if (runId && [\"add\", \"duplicateNode\", \"deleteNode\", \"removeEdge\", \"addEdge\", \"connectTo\", \"connectFrom\", \"undo\", \"redo\", \"applyJSON\", \"save\", \"saveDraft\", \"arrange\"].includes(action)) return notice(\"This canvas is a saved run snapshot. Open the workflow to edit it.\");\n      if (action === \"loadEvents\") { const result = await api.manage(\"workflowEventTypes\", { connectionId: id }); eventChoices[id] = result.items; draw(); }\n      if (action === \"new\") newFlow();\n      if (action === \"edit\") open(data.workflows.find(w => w.id === id));\n      if (action === \"duplicate\") { const w = clone(data.workflows.find(w => w.id === id)); delete w.id; w.name += \" copy\"; w.enabled = false; delete w.legacyTask; open(w); }\n      if (action === \"template\") open(M.template(id, data.models[0]?.alias || \"\", data.connections.find(c => c.enabled)));\n      if (action === \"templates\") await api.navigate(\"templates\");\n      if (action === \"back\") { if (!await canLeave()) return; draft = null; runId = \"\"; linking = null; await refresh(); draw(); }\n      if (action === \"inspector\") { inspector = id; draw(); }\n      if (action === \"palette\") host.querySelector(\".wf-palette\")?.classList.toggle(\"show\");\n      if (action === \"add\") { if (id === \"trigger\" && draft.graph.nodes.some(n => n.type === \"trigger\")) throw Error(\"A workflow has one trigger. Select it to change how the workflow starts.\"); commit(() => { const anchor = currentNode()?.position || { x: 80, y: 70 }; selected = \"n\" + Date.now().toString(36); const position = { x: anchor.x, y: anchor.y + 180 }; while (draft.graph.nodes.some(n => Math.abs(n.position.x - position.x) < 260 && Math.abs(n.position.y - position.y) < 160)) position.y += 180; const n = M.node(id, selected, position); if (id === \"agent\") n.config.model = draft.model; draft.graph.nodes.push(n); inspector = \"node\"; }); }\n      if (action === \"duplicateNode\") { const n = currentNode(); if (!n || n.type === \"trigger\") return; commit(() => { const copied = clone(n); copied.id = \"n\" + Date.now().toString(36); copied.position.x += 40; copied.position.y += 160; draft.graph.nodes.push(copied); selected = copied.id; }); }\n      if (action === \"deleteNode\") { const n = currentNode(); if (!n || n.type === \"trigger\") return; commit(() => { draft.graph.nodes = draft.graph.nodes.filter(x => x.id !== n.id); draft.graph.edges = draft.graph.edges.filter(x => x.from !== n.id && x.to !== n.id); selected = \"\"; }); }\n      if (action === \"removeEdge\") commit(() => { draft.graph.edges = draft.graph.edges.filter(e => e.id !== id); });\n      if (action === \"selectEdge\") { const edge = draft.graph.edges.find(e => e.id === id); if (edge) { selected = edge.from; inspector = \"node\"; draw(); notice(\"Connection selected. Remove it in the node's Connections list.\"); } }\n      if (action === \"connectFrom\") { linking = { from: id, port: button.dataset.port }; notice(\"Choose the destination node's input dot.\"); }\n      if (action === \"connectTo\" && linking) { connect(linking.from, id, linking.port); linking = null; }\n      if (action === \"addEdge\") { const get = key => host.querySelector(`[data-field=\"${key}\"]`)?.value; if (!get(\"linkTarget\")) throw Error(\"Choose the destination node.\"); connect(selected, get(\"linkTarget\"), get(\"linkPort\"), get(\"linkInput\")); }\n      if (action === \"undo\" && undo.length) { redo.push(clone(draft)); draft = undo.pop(); draw(); } if (action === \"redo\" && redo.length) { undo.push(clone(draft)); draft = redo.pop(); draw(); }\n      if (action === \"zoomIn\") { zoom = Math.min(1.8, zoom * 1.2); paint(); } if (action === \"zoomOut\") { zoom = Math.max(.18, zoom / 1.2); paint(); } if (action === \"fit\") fit();\n      if (action === \"arrange\") { commit(() => { const levels = new Map([[draft.graph.nodes.find(n => n.type === \"trigger\")?.id, 0]]); for (let i = 0; i < draft.graph.nodes.length; i++) for (const edge of draft.graph.edges) if (levels.has(edge.from) && !levels.has(edge.to)) levels.set(edge.to, levels.get(edge.from) + 1); const counts = {}; for (const n of draft.graph.nodes) { const level = levels.get(n.id) ?? 0; n.position = { x: 60 + (counts[level] || 0) * 310, y: 50 + level * 170 }; counts[level] = (counts[level] || 0) + 1; } }); fit(); }\n      if (action === \"validate\") { const report = await api.manage(\"workflowValidate\", draft); notice(report.errors.length ? report.errors.map(e => e.message).join(\" \") : \"The flow is valid.\" + (report.nextRunAt ? \" Next scheduled run: \" + date(report.nextRunAt) : \"\") + (report.warnings.length ? \" \" + report.warnings.map(w => w.message).join(\" \") : \"\"), !!report.errors.length); }\n      if ([\"save\", \"saveDraft\"].includes(action)) { if (invalid) throw Error(invalid); busy = true; const w = await api.manage(action === \"saveDraft\" ? \"workflowDraft\" : \"workflow\", draft); await refresh(); draft = M.fromLegacy(w); savedJSON = JSON.stringify(draft); draw(); notice(action === \"saveDraft\" ? \"Draft saved. Review it before enabling or running.\" : \"Workflow saved.\"); }\n      if (action === \"toggle\") { const w = data.workflows.find(w => w.id === id); await api.manage(\"workflowEnabled\", { id, enabled: !w.enabled }); await refresh(); draw(); }\n      if (action === \"delete\") { if (!await window.kai.dialogs.confirm(\"Delete this workflow and its run history?\")) return; await api.manage(\"removeWorkflow\", { id }); await refresh(); draw(); }\n      if (action === \"import\") { const w = await api.manage(\"importWorkflow\"); await refresh(); if (w) open(w); }\n      if (action === \"export\") await api.manage(\"exportWorkflow\", { id });\n      if (action === \"run\" || action === \"preview\") { if (draft && !runId && dirty()) throw Error(\"Save the changes before running this workflow.\"); modal = { id, preview: action === \"preview\" }; draw(); host.querySelector('.wf-modal textarea')?.focus(); }\n      if (action === \"closeModal\") closeModal();\n      if (action === \"history\") { draft = null; runFilter = id; await api.navigate(\"runs\"); }\n      if ([\"runCanvas\", \"selectRun\"].includes(action)) { const run = data.runs.find(r => r.id === id); open(run.spec); runId = id; inspector = \"runs\"; draw(); fit(); }\n      if (action === \"resume\") { await api.manage(\"resume\", { id }); await refresh(); draw(); }\n      if (action === \"reject\") { await api.manage(\"workflowReject\", { id }); await refresh(); draw(); }\n      if (action === \"cancel\") { await api.manage(\"cancelRun\", { id }); await refresh(); draw(); }\n      if (action === \"refresh\") { await refresh(); draw(); }\n      if (action === \"quickBuild\") { const request = host.querySelector(\"#wf-quick-prompt\").value; newFlow(); inspector = \"copilot\"; draw(); host.querySelector('[data-field=\"assistRequest\"]').value = request; }\n      if (action === \"applyProposal\" && proposal) { commit(() => { draft = { ...proposal.proposal, ...(draft.id ? { id: draft.id } : {}), enabled: false }; selected = draft.graph.nodes[0]?.id; proposal = null; inspector = \"node\"; }); fit(); }\n      if (action === \"dismissProposal\") { proposal = null; draw(); }\n      if (action === \"applyJSON\") { const raw = JSON.parse(host.querySelector(\"#wf-document\").value), doc = M.importDocument(raw); commit(() => { draft = { ...doc, ...(draft.id ? { id: draft.id } : {}) }; }); }\n      if (action === \"copyExpr\") { const text = \"=nodes.\" + id + \".text\"; await window.kai.call(\"workflows.copyText\", { text }); notice(\"Copied \" + text); }\n      if (action === \"dismiss\") { await api.manage(\"workflowDismiss\", { id }); await refresh(); draw(); }\n      if (action === \"buildSuggestion\") { const suggestion = data.workflowState.suggestions.find(s => s.id === id); open(M.template(suggestion.template, data.models[0]?.alias || \"\", data.connections.find(c => c.enabled))); draft.name = suggestion.name; inspector = \"copilot\"; draw(); host.querySelector('[data-field=\"assistRequest\"]').value = suggestion.request; }\n    } catch (error) { notice(error.message, true); } finally { busy = false; poll(); }\n  }\n  function connect(from, to, port = \"main\", input = \"main\") { if (draft.graph.nodes.find(n => n.id === to)?.type === \"trigger\") throw Error(\"Connect to an action or logic node, not the trigger.\"); const edge = M.edge(from, to, port, input || \"main\"); if (draft.graph.edges.some(e => e.id === edge.id)) throw Error(\"These ports are already connected.\"); commit(() => draft.graph.edges.push(edge)); }\n  async function submit(e) {\n    const form = e.target.closest(\"[data-wf-form]\"); if (!form) return; e.preventDefault(); if (busy) return; busy = true;\n    const button = form.querySelector('button:not([type=\"button\"])'); if (button) button.disabled = true;\n    try {\n      const type = form.dataset.wfForm, get = key => form.querySelector(`[data-field=\"${key}\"]`);\n      if (type === \"run\") { const m = modal, input = form.elements.input.value; const result = await api.manage(m.preview ? \"workflowPreview\" : \"run\", { id: m.id, input }); modal = null; await refresh(); draft = null; runId = \"\"; runFilter = m.id; await api.navigate(\"runs\"); notice(m.preview ? \"Preview started with simulated capability outputs.\" : \"Workflow started.\"); }\n      if (type === \"assist\") { notice(\"KAI is designing the flow…\"); proposal = await api.manage(\"workflowAssist\", { request: get(\"assistRequest\").value, model: get(\"assistModel\").value, workflow: draft }); draw(); notice(\"Review the proposed changes, then apply them to the canvas.\"); }\n      if (type === \"discoverySettings\") { await api.manage(\"workflowDiscoverySettings\", { enabled: get(\"discoveryEnabled\").checked, model: get(\"discoveryModel\").value, includeBrain: get(\"discoveryBrain\").checked }); await refresh(); draw(); }\n      if (type === \"discover\") { notice(\"Looking for useful routines…\"); await api.manage(\"workflowDiscover\", { model: get(\"discoverModel\").value, includeBrain: get(\"discoverBrain\").checked }); await refresh(); draw(); }\n    } catch (error) { notice(error.message, true); } finally { busy = false; if (button) button.disabled = false; host.querySelectorAll('[data-wf-form=\"assist\"] button,[data-wf-form=\"discover\"] button').forEach(b => { b.disabled = false; KaiI18n.setText(b, b.closest('[data-wf-form=\"assist\"]') ? \"Suggest changes\" : \"Find suggestions\"); }); poll(); }\n  }\n  function pointerdown(e) {\n    if (!draft || e.button !== 0) return;\n    const heading = e.target.closest(\"[data-drag-node]\"), viewport = e.target.closest(\".wf-viewport\"), port = e.target.closest('[data-wf=\"connectFrom\"]');\n    if (port && !runId) { const from = port.dataset.id, output = port.dataset.port; const finish = ev => { window.removeEventListener(\"pointerup\", finish); const target = document.elementFromPoint(ev.clientX, ev.clientY)?.closest('[data-wf=\"connectTo\"]'); if (target) { try { connect(from, target.dataset.id, output); linking = null; } catch (error) { notice(error.message, true); } } }; window.addEventListener(\"pointerup\", finish, { once: true }); return; }\n    if (heading && !runId) {\n      e.preventDefault(); const n = draft.graph.nodes.find(n => n.id === heading.dataset.dragNode), start = { x: e.clientX, y: e.clientY, ...n.position }, old = { ...n.position }; history(); selected = n.id;\n      const move = ev => { n.position = { x: Math.max(0, Math.min(6000, Math.round((old.x + (ev.clientX - e.clientX) / zoom) / 10) * 10)), y: Math.max(0, Math.min(12000, Math.round((old.y + (ev.clientY - e.clientY) / zoom) / 10) * 10)) }; const nodeEl = host.querySelector(`[data-node=\"${n.id}\"]`); if (nodeEl) { nodeEl.style.left = n.position.x + \"px\"; nodeEl.style.top = n.position.y + \"px\"; } paint(); };\n      const up = () => { window.removeEventListener(\"pointermove\", move); window.removeEventListener(\"pointerup\", up); inspector = \"node\"; draw(); }; window.addEventListener(\"pointermove\", move); window.addEventListener(\"pointerup\", up, { once: true }); return;\n    }\n    if (viewport && !e.target.closest(\"button,[data-node],.wf-edge\")) { e.preventDefault(); const old = { ...pan }; const move = ev => { pan = { x: old.x + ev.clientX - e.clientX, y: old.y + ev.clientY - e.clientY }; paint(); }; const up = () => { window.removeEventListener(\"pointermove\", move); }; window.addEventListener(\"pointermove\", move); window.addEventListener(\"pointerup\", up, { once: true }); }\n  }\n  function wheel(e) { e.preventDefault(); if (e.ctrlKey || e.metaKey) { const old = zoom, rect = e.currentTarget.getBoundingClientRect(), x = e.clientX - rect.left, y = e.clientY - rect.top; zoom = Math.max(.18, Math.min(1.8, zoom * (e.deltaY < 0 ? 1.08 : .92))); pan = { x: x - (x - pan.x) * zoom / old, y: y - (y - pan.y) * zoom / old }; } else { pan.x -= e.deltaX; pan.y -= e.deltaY; } paint(); }\n  function closeModal() {\n    const previous = modal; modal = null; draw();\n    if (previous) [...host.querySelectorAll(\"[data-wf]\")].find(button => button.dataset.id === previous.id && button.dataset.wf === (previous.preview ? \"preview\" : \"run\"))?.focus();\n  }\n  function keydown(e) {\n    if (e.key === \"Escape\") { linking = null; if (modal) closeModal(); else draw(); return; }\n    if (modal && e.key === \"Tab\") {\n      const controls = [...(host.querySelector(\".wf-modal\")?.querySelectorAll('button:not(:disabled),input:not(:disabled),textarea:not(:disabled),select:not(:disabled),[tabindex=\"0\"]') || [])];\n      const first = controls[0], last = controls.at(-1);\n      if (first && e.shiftKey && (document.activeElement === first || !controls.includes(document.activeElement))) { e.preventDefault(); last.focus(); }\n      else if (first && !e.shiftKey && (document.activeElement === last || !controls.includes(document.activeElement))) { e.preventDefault(); first.focus(); }\n      return;\n    }\n    if (!draft || e.target.matches(\"input,textarea,select\") || runId) return;\n    if ((e.ctrlKey || e.metaKey) && [\"z\", \"y\"].includes(e.key.toLowerCase())) { e.preventDefault(); const action = e.key.toLowerCase() === \"y\" || e.shiftKey ? \"redo\" : \"undo\"; host.querySelector(`[data-wf=\"${action}\"]`)?.click(); }\n    if (e.key === \"Delete\" || e.key === \"Backspace\") { e.preventDefault(); host.querySelector('[data-wf=\"deleteNode\"]')?.click(); }\n    if ([\"ArrowUp\", \"ArrowDown\", \"ArrowLeft\", \"ArrowRight\"].includes(e.key) && currentNode()) { e.preventDefault(); commit(() => { const p = currentNode().position; p.x = Math.max(0, p.x + (e.key === \"ArrowRight\" ? 20 : e.key === \"ArrowLeft\" ? -20 : 0)); p.y = Math.max(0, p.y + (e.key === \"ArrowDown\" ? 20 : e.key === \"ArrowUp\" ? -20 : 0)); }); }\n  }\n  function poll() { clearTimeout(timer); if (!host?.isConnected || host.closest('[hidden]')) return; timer = setTimeout(async () => { if (!host?.isConnected || host.closest('[hidden]')) return; if (!busy && (section === \"runs\" || runId || inspector === \"runs\" && draft)) { try { const before = JSON.stringify(data.runs); await refresh(); if (before !== JSON.stringify(data.runs) && !host.querySelector(\"input:focus,textarea:focus,select:focus\")) { const opened = [...host.querySelectorAll(\"details[open]\")].map(el => el.dataset.run).filter(Boolean); draw(); for (const id of opened) host.querySelector(`[data-run=\"${id}\"]`)?.setAttribute(\"open\", \"\"); } } catch { /* keep the last view */ } } poll(); }, 2000); }\n  async function canLeave() {\n    if (!dirty() || runId) return true;\n    const reviewed = draft, snapshot = JSON.stringify(draft);\n    const approved = await window.kai.dialogs.confirm(\"Discard unsaved workflow changes?\");\n    return approved === true && draft === reviewed && JSON.stringify(draft) === snapshot;\n  }\n  window.KaiWorkflows = { render, canLeave, hasUnsavedChanges: () => !!dirty() && !runId, leave: () => { if (host) { host.onchange = null; host.oninput = null; } draft = null; runId = \"\"; clearTimeout(timer); }, isEditing: () => !!draft };\n})();\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"gT9jjwEmTgPP9t2cMAhjgmgo3EniMcH79dcNoP4SghnY07vrbSFf+QKB7eV9VWEqAlcNuFBVClyXdn7ykXBkDQ=="}