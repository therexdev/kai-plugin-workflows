{"manifest":{"schema":1,"apiVersion":2,"id":"kai.workflows","name":"Workflows","version":"0.1.0","description":"Build reusable local agents and workflows with saved runs and human review.","entry":"index.html","permissions":["models.read","workflows.read","workflows.write","workflows.run"]},"files":{"app.js":"\"use strict\";\nconst $ = id => document.getElementById(id), state = { workflows: [], agents: [], models: [], steps: [], editing: null, agentId: null, launchId: null, runId: null, advanced: false, polling: false };\nconst call = (method, input) => window.kai.call(method, input);\nfunction notice(message, error = false) { $(\"notice\").textContent = message; $(\"notice\").className = error ? \"error\" : \"\"; }\nfunction act(fn) { return async event => { const button = event?.currentTarget; if (button?.tagName === \"BUTTON\") button.disabled = true; try { await fn(event); } catch (e) { notice(e.message || String(e), true); } finally { if (button?.isConnected) button.disabled = false; } }; }\nfunction el(tag, text, className) { const node = document.createElement(tag); if (text !== undefined) node.textContent = text; if (className) node.className = className; return node; }\nfunction button(text, fn, className = \"small\") { const node = el(\"button\", text, className); node.addEventListener(\"click\", act(fn)); return node; }\nfunction field(label, input) { const node = el(\"label\", label); node.append(input); return node; }\nfunction input(value, change, area = false) { const node = el(area ? \"textarea\" : \"input\"); node.value = value || \"\"; if (area) node.rows = 3; node.addEventListener(\"input\", () => change(node.value)); return node; }\nfunction select(options, value, change) { const node = el(\"select\"); for (const [id, label] of options) { const option = el(\"option\", label); option.value = id; node.append(option); } node.value = value || \"\"; node.addEventListener(\"change\", () => change(node.value)); return node; }\nfunction fillModels(node, value = \"\") { node.replaceChildren(); const options = [[\"\", \"Choose an installed model\"], ...state.models.map(m => [m.alias, m.label || m.alias])]; for (const [id, label] of options) { const option = el(\"option\", label); option.value = id; node.append(option); } node.value = value; }\nfunction tab(name) { document.querySelectorAll(\".panel\").forEach(node => { node.hidden = node.id !== name; }); document.querySelectorAll(\"nav button\").forEach(node => node.classList.toggle(\"active\", node.dataset.tab === name)); if (name === \"runs\") void refreshRuns().catch(e => notice(e.message, true)); }\nfunction empty(container, message) { if (!container.childElementCount) container.append(el(\"div\", message, \"empty\")); }\nasync function refresh() {\n  const [flows, agents, models] = await Promise.all([call(\"workflows.list\"), call(\"workflows.agents\"), call(\"models.list\")]);\n  state.workflows = flows.workflows; state.agents = agents; state.models = models.filter(m => m.status === \"ready\");\n  $(\"flow-count\").textContent = state.workflows.length; $(\"agent-count\").textContent = agents.length; renderFlows(); renderAgents();\n  if (!state.models.length) notice(\"Install a local model in KAI Core to create reasoning steps. Output and review flows work without a model.\");\n}\nfunction renderFlows() {\n  const container = $(\"flow-list\"); container.replaceChildren();\n  for (const flow of state.workflows) {\n    const card = el(\"article\", undefined, \"card\"); card.append(el(\"div\", flow.runnable ? \"MANUAL FLOW\" : \"PRESERVED FLOW\", \"badge\"), el(\"h3\", flow.name), el(\"p\", flow.description || \"A reusable sequence of local steps.\"));\n    if (flow.unavailableReason) card.append(el(\"p\", flow.unavailableReason, \"unavailable\"));\n    const actions = el(\"div\", undefined, \"actions\");\n    if (!flow.unavailableReason) {\n      actions.append(button(\"Run →\", () => openLaunch(flow), \"small primary\"), button(\"Edit\", async () => openDraft(await call(\"workflows.get\", { id: flow.id }))), button(\"Export\", async () => { $(\"exchange\").hidden = false; $(\"exchange-json\").value = JSON.stringify(await call(\"workflows.export\", { id: flow.id }), null, 2); $(\"exchange\").scrollIntoView({ behavior: \"smooth\" }); }), button(\"Delete\", async () => { if (!window.confirm(\"Delete this workflow and its plugin run history?\")) return; await call(\"workflows.remove\", { id: flow.id }); await refresh(); }, \"small danger\"));\n    }\n    card.append(actions); container.append(card);\n  }\n  empty(container, \"No workflows yet. Create a flow, add a local agent, and give it an input.\");\n}\nfunction newDraft() { state.editing = null; state.steps = [{ type: \"agent\", label: \"Think\", text: \"Respond to this request:\\n{{input}}\" }, { type: \"output\", label: \"Result\", text: \"{{previous}}\" }]; state.advanced = false; $(\"flow-name\").value = \"\"; $(\"flow-description\").value = \"\"; fillModels($(\"flow-model\"), state.models[0]?.alias); showEditor(); }\nfunction showEditor() { tab(\"workflows\"); $(\"editor\").hidden = false; $(\"editor-title\").textContent = state.editing ? \"Edit workflow\" : \"New workflow\"; renderSteps(); $(\"editor\").scrollIntoView({ behavior: \"smooth\", block: \"start\" }); }\nfunction openDraft(flow) {\n  state.editing = flow.id || null; $(\"flow-name\").value = flow.name || \"Imported workflow\"; $(\"flow-description\").value = flow.description || \"\"; fillModels($(\"flow-model\"), flow.model || \"\"); state.advanced = true; $(\"graph-json\").value = JSON.stringify(flow.graph, null, 2); state.steps = []; showEditor(); notice(\"Review the graph before saving. Existing graph definitions are edited without losing their settings.\");\n}\nconst STEP_TYPES = [[\"agent\", \"Local agent\"], [\"saved_agent\", \"Saved agent\"], [\"sub_workflow\", \"Saved workflow\"], [\"approval\", \"Human review\"], [\"output_parser\", \"Parse output\"], [\"output\", \"Result\"]];\nfunction renderSteps() {\n  $(\"steps\").hidden = state.advanced; $(\"add-step\").hidden = state.advanced; $(\"graph-editor\").hidden = !state.advanced; $(\"template\").hidden = state.advanced;\n  $(\"advanced-toggle\").textContent = state.advanced ? \"Start fresh in step builder\" : \"Graph JSON\";\n  const container = $(\"steps\"); container.replaceChildren();\n  state.steps.forEach((s, index) => {\n    const row = el(\"article\", undefined, \"step\"), head = el(\"div\", undefined, \"step-head\"), controls = el(\"div\", undefined, \"actions\");\n    controls.append(button(\"↑\", () => { if (index) [state.steps[index - 1], state.steps[index]] = [state.steps[index], state.steps[index - 1]]; renderSteps(); }), button(\"↓\", () => { if (index < state.steps.length - 1) [state.steps[index + 1], state.steps[index]] = [state.steps[index], state.steps[index + 1]]; renderSteps(); }), button(\"Remove\", () => { state.steps.splice(index, 1); renderSteps(); }, \"small danger\"));\n    head.append(el(\"span\", \"STEP \" + String(index + 1).padStart(2, \"0\"), \"step-num\"), controls); row.append(head);\n    const grid = el(\"div\", undefined, \"form-grid\"); grid.append(field(\"Action\", select(STEP_TYPES, s.type, value => { s.type = value; renderSteps(); })), field(\"Label\", input(s.label, value => s.label = value))); row.append(grid);\n    if (s.type === \"saved_agent\") row.append(field(\"Agent\", select([[\"\", \"Choose a saved agent\"], ...state.agents.map(a => [a.id, a.name])], s.agentId, value => s.agentId = value)));\n    if (s.type === \"sub_workflow\") row.append(field(\"Workflow\", select([[\"\", \"Choose a saved workflow\"], ...state.workflows.filter(w => w.runnable && w.id !== state.editing).map(w => [w.id, w.name])], s.workflowId, value => s.workflowId = value)));\n    if (s.type === \"agent\") row.append(field(\"Model\", select([[\"\", \"Use the flow's default model\"], ...state.models.map(m => [m.alias, m.label || m.alias])], s.model, value => s.model = value)));\n    if ([\"agent\", \"saved_agent\", \"approval\", \"output\"].includes(s.type)) row.append(field(s.type === \"approval\" ? \"Review message\" : s.type === \"output\" ? \"Result template\" : \"Prompt\", input(s.text, value => s.text = value, true)));\n    if (s.type === \"output_parser\") { row.append(field(\"Format\", select([[\"json\", \"JSON\"], [\"csv\", \"CSV\"], [\"text\", \"Text\"]], s.format || \"json\", value => s.format = value)), field(\"Required fields (comma separated)\", input(s.required, value => s.required = value))); }\n    container.append(row);\n  });\n}\nfunction draft() { return { ...(state.editing ? { id: state.editing } : {}), name: $(\"flow-name\").value, description: $(\"flow-description\").value, model: $(\"flow-model\").value, ...(state.advanced ? { graph: JSON.parse($(\"graph-json\").value) } : { steps: state.steps }) }; }\nfunction renderAgents() {\n  const container = $(\"agent-list\"); container.replaceChildren();\n  for (const a of state.agents) { const card = el(\"article\", undefined, \"card\"), actions = el(\"div\", undefined, \"actions\"); card.append(el(\"div\", \"LOCAL AGENT\", \"badge\"), el(\"h3\", a.name), el(\"p\", a.instructions.slice(0, 160)), el(\"span\", a.model, \"hint\")); actions.append(button(\"Edit\", () => editAgent(a)), button(\"Delete\", async () => { if (!window.confirm(\"Delete this saved agent? Existing workflow copies will remain.\")) return; await call(\"workflows.agentRemove\", { id: a.id }); await refresh(); }, \"small danger\")); card.append(actions); container.append(card); }\n  empty(container, \"Create a reusable agent such as an editor, planner or reviewer. Each uses an installed local model.\");\n}\nfunction editAgent(a = {}) { state.agentId = a.id || null; $(\"agent-name\").value = a.name || \"\"; $(\"agent-instructions\").value = a.instructions || \"\"; fillModels($(\"agent-model\"), a.model || state.models[0]?.alias); $(\"agent-editor\").hidden = false; $(\"agent-editor\").scrollIntoView({ behavior: \"smooth\" }); }\nfunction openLaunch(flow) { state.launchId = flow.id; $(\"launch-title\").textContent = \"Run · \" + flow.name; $(\"run-input\").value = \"\"; $(\"launch\").hidden = false; $(\"launch\").scrollIntoView({ behavior: \"smooth\" }); $(\"run-input\").focus(); }\nasync function refreshRuns() {\n  const runs = await call(\"workflows.runs\"), container = $(\"run-list\"); container.replaceChildren();\n  for (const r of runs) { const card = el(\"article\", undefined, \"card\"); card.append(el(\"div\", r.status.toUpperCase(), \"badge\"), el(\"h3\", r.name), el(\"p\", new Date(r.startedAt).toLocaleString()), button(\"View result\", async () => { state.runId = r.id; await showRun(); })); container.append(card); }\n  empty(container, \"Completed, paused and stopped runs appear here. Earlier app history stays preserved in its original storage.\");\n}\nasync function showRun() {\n  if (!state.runId) return; const r = await call(\"workflows.runGet\", { id: state.runId }); state.pollStatus = r.status;\n  $(\"run-detail\").hidden = false; $(\"run-title\").textContent = r.name; $(\"run-status\").textContent = r.status.toUpperCase(); $(\"run-output\").textContent = r.error || (r.status === \"waiting\" ? JSON.stringify(r.pending, null, 2) : r.previous || \"Waiting for the local model…\");\n  const actions = $(\"run-actions\"); actions.replaceChildren();\n  if (r.status === \"waiting\") actions.append(button(\"Approve and continue\", async () => { await call(\"workflows.decide\", { id: r.id, decision: \"approved\" }); await showRun(); }, \"primary\"), button(\"Reject\", async () => { await call(\"workflows.decide\", { id: r.id, decision: \"rejected\" }); await showRun(); }));\n  if ([\"running\", \"waiting\", \"interrupted\"].includes(r.status)) actions.append(button(\"Stop run\", async () => { await call(\"workflows.cancel\", { id: r.id }); await showRun(); await refreshRuns(); }, \"danger\"));\n  const steps = $(\"run-steps\"); steps.replaceChildren(); for (const s of r.steps || []) { const details = el(\"details\"); details.append(el(\"summary\", s.label + \" · \" + s.status), el(\"pre\", s.output || s.error || \"Running…\")); steps.append(details); }\n  return r;\n}\ndocument.querySelectorAll(\"nav button\").forEach(node => node.addEventListener(\"click\", () => tab(node.dataset.tab)));\n$(\"new-flow\").addEventListener(\"click\", newDraft); $(\"editor-close\").addEventListener(\"click\", () => $(\"editor\").hidden = true);\n$(\"add-step\").addEventListener(\"click\", () => { if (state.steps.length >= 18) return notice(\"A flow can contain up to 18 steps.\", true); state.steps.push({ type: \"agent\", label: \"Agent\", text: \"{{previous}}\" }); renderSteps(); });\n$(\"template\").addEventListener(\"click\", () => { state.steps = [{ type: \"agent\", label: \"Plan\", text: \"Create a concise outline for this request:\\n{{input}}\" }, { type: \"agent\", label: \"Draft\", text: \"Write a useful draft from this outline:\\n{{previous}}\" }, { type: \"approval\", label: \"Review\", text: \"Review this draft:\\n{{previous}}\" }, { type: \"agent\", label: \"Refine\", text: \"Improve the clarity of this draft while preserving its meaning:\\n{{previous}}\" }, { type: \"output\", label: \"Final result\", text: \"{{previous}}\" }]; if (!$(\"flow-name\").value) $(\"flow-name\").value = \"Plan, draft and refine\"; renderSteps(); });\n$(\"advanced-toggle\").addEventListener(\"click\", act(async () => { if (state.advanced) { if (!window.confirm(\"Replace this graph with a fresh step builder draft?\")) return; state.advanced = false; state.steps = [{ type: \"agent\", text: \"{{input}}\" }, { type: \"output\", text: \"{{previous}}\" }]; } else { const saved = await call(\"workflows.save\", draft()); state.editing = saved.id; $(\"graph-json\").value = JSON.stringify(saved.graph, null, 2); state.advanced = true; await refresh(); notice(\"Workflow saved. You can now edit its version 2 graph.\"); } renderSteps(); }));\n$(\"save-flow\").addEventListener(\"click\", act(async () => { const saved = await call(\"workflows.save\", draft()); state.editing = saved.id; await refresh(); notice(\"Workflow saved. Run it from the library when ready.\"); $(\"editor\").hidden = true; }));\n$(\"import-toggle\").addEventListener(\"click\", () => $(\"exchange\").hidden = !$(\"exchange\").hidden);\n$(\"import-flow\").addEventListener(\"click\", act(() => { const raw = JSON.parse($(\"exchange-json\").value), flow = raw.workflow || raw; if (!flow.graph) throw Error(\"Paste a workflow with a version 2 graph.\"); openDraft({ ...flow, id: undefined }); notice(\"Imported as an unsaved draft. Review the graph, then save.\"); }));\n$(\"new-agent\").addEventListener(\"click\", () => editAgent()); $(\"agent-close\").addEventListener(\"click\", () => $(\"agent-editor\").hidden = true);\n$(\"save-agent\").addEventListener(\"click\", act(async () => { await call(\"workflows.agentSave\", { ...(state.agentId ? { id: state.agentId } : {}), name: $(\"agent-name\").value, instructions: $(\"agent-instructions\").value, model: $(\"agent-model\").value }); await refresh(); $(\"agent-editor\").hidden = true; notice(\"Agent saved. Choose Saved agent when adding a workflow step.\"); }));\n$(\"launch-close\").addEventListener(\"click\", () => $(\"launch\").hidden = true);\n$(\"start-run\").addEventListener(\"click\", act(async () => { const r = await call(\"workflows.run\", { id: state.launchId, input: $(\"run-input\").value }); state.runId = r.id; $(\"launch\").hidden = true; tab(\"runs\"); await showRun(); notice(\"Run started locally. Keep this plugin window open.\"); }));\n$(\"refresh-runs\").addEventListener(\"click\", act(refreshRuns));\nsetInterval(async () => { if (state.polling || !state.runId || $(\"runs\").hidden || [\"completed\", \"failed\", \"cancelled\"].includes(state.pollStatus)) return; state.polling = true; try { const r = await showRun(); if ([\"completed\", \"failed\", \"cancelled\"].includes(r.status)) await refreshRuns(); } catch (e) { notice(e.message, true); } finally { state.polling = false; } }, 1800);\nvoid refresh().catch(e => notice(e.message || \"Open this plugin from KAI Core to connect to its local runtime.\", true));\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>KAI Workflows</title><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<header><div class=\"brand\">K<span>AI</span> <span class=\"divider\">/</span> WORKFLOWS</div><span class=\"pill\">LOCAL RUNTIME · V2</span></header>\n<main><section class=\"intro\"><div><p class=\"eyebrow\">BUILD ONCE. RUN WHEN YOU NEED.</p><h1>Your agents, working together.</h1><p>Give an agent a role. Connect steps into a flow. Keep every result.</p></div><button id=\"new-flow\" class=\"primary\">+ New workflow</button></section>\n<nav aria-label=\"Workspace\"><button data-tab=\"workflows\" class=\"active\">Workflows <span id=\"flow-count\">0</span></button><button data-tab=\"agents\">Agents <span id=\"agent-count\">0</span></button><button data-tab=\"runs\">Run history</button></nav>\n<p id=\"notice\" role=\"status\" aria-live=\"polite\"></p>\n<section id=\"workflows\" class=\"panel\"><div class=\"section-head\"><h2>Workflow library</h2><button id=\"import-toggle\">Import / export JSON</button></div><div id=\"flow-list\" class=\"cards\"></div>\n<section id=\"editor\" class=\"editor\" hidden><div class=\"section-head\"><h2 id=\"editor-title\">New workflow</h2><button id=\"editor-close\">Close</button></div><div class=\"form-grid\"><label>Name<input id=\"flow-name\" maxlength=\"100\" placeholder=\"Research, draft and refine\"></label><label>Default local model<select id=\"flow-model\"></select></label></div><label>Description<input id=\"flow-description\" maxlength=\"1000\" placeholder=\"What should this flow help you do?\"></label><div class=\"section-head\"><h3>Steps</h3><div class=\"actions\"><button id=\"template\">Use writing template</button><button id=\"advanced-toggle\">Graph JSON</button></div></div><p class=\"hint\">Use {{input}} for your original request and {{previous}} for the preceding result. Saved agents are copied into the flow when you save.</p><div id=\"steps\"></div><button id=\"add-step\">+ Add step</button><label id=\"graph-editor\" hidden>Version 2 graph<textarea id=\"graph-json\" class=\"code\" rows=\"16\" spellcheck=\"false\"></textarea></label><div class=\"editor-footer\"><span id=\"draft-note\" class=\"hint\">Manual execution · Up to 18 steps</span><button id=\"save-flow\" class=\"primary\">Save workflow</button></div></section>\n<section id=\"exchange\" class=\"editor\" hidden><h2>Portable workflow definition</h2><p class=\"hint\">Copy this JSON to share a definition, or paste one to review as a draft. Review prompts before sharing; sub-workflow IDs refer to your local library.</p><textarea id=\"exchange-json\" class=\"code\" rows=\"10\" spellcheck=\"false\" aria-label=\"Workflow definition JSON\"></textarea><button id=\"import-flow\">Review imported workflow</button></section>\n</section>\n<section id=\"agents\" class=\"panel\" hidden><div class=\"section-head\"><div><h2>Reusable agents</h2><p class=\"hint\">Save a specialist, then add it to any workflow.</p></div><button id=\"new-agent\" class=\"primary\">+ New agent</button></div><div id=\"agent-list\" class=\"cards\"></div><section id=\"agent-editor\" class=\"editor\" hidden><div class=\"section-head\"><h2>Agent profile</h2><button id=\"agent-close\">Close</button></div><div class=\"form-grid\"><label>Name<input id=\"agent-name\" maxlength=\"100\" placeholder=\"Editor\"></label><label>Local model<select id=\"agent-model\"></select></label></div><label>Instructions<textarea id=\"agent-instructions\" rows=\"6\" maxlength=\"4000\" placeholder=\"You are a careful editor. Improve clarity and preserve the author's meaning.\"></textarea></label><button id=\"save-agent\" class=\"primary\">Save agent</button></section></section>\n<section id=\"runs\" class=\"panel\" hidden><div class=\"section-head\"><h2>Saved runs</h2><button id=\"refresh-runs\">Refresh</button></div><div id=\"run-list\" class=\"cards\"></div><section id=\"run-detail\" class=\"editor\" hidden><div class=\"section-head\"><h2 id=\"run-title\">Run</h2><span id=\"run-status\" class=\"pill\"></span></div><pre id=\"run-output\"></pre><div id=\"run-actions\" class=\"actions\"></div><div id=\"run-steps\"></div></section></section>\n<section id=\"launch\" class=\"editor\" hidden><div class=\"section-head\"><h2 id=\"launch-title\">Run workflow</h2><button id=\"launch-close\">Close</button></div><p class=\"hint\">Only the input below and this flow's instructions go to your local model. This window must stay open while the run is active.</p><label>Input<textarea id=\"run-input\" rows=\"4\" maxlength=\"16000\" placeholder=\"What should this workflow work on?\"></textarea></label><button id=\"start-run\" class=\"primary\">Run locally →</button></section>\n<footer>Installed local models · Encrypted workflow history · Manual runs only<br><span>Brain access, connected accounts, schedules and native actions are unavailable in this release. Existing flows that need them are preserved.</span></footer></main><script src=\"app.js\"></script></body></html>\n","style.css":":root{color-scheme:dark;font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#e8edf2;background:#0c1119;font-size:14px}*{box-sizing:border-box}body{margin:0}header{height:70px;border-bottom:1px solid #26303d;display:flex;align-items:center;justify-content:space-between;padding:0 38px;background:#101722}.brand{font-weight:750;letter-spacing:.12em}.brand>span:first-child{color:#63e3c0}.divider{color:#526174;margin:0 16px}.pill{font-size:10px;letter-spacing:.12em;border:1px solid #344454;background:#16212c;border-radius:20px;color:#a3d9cd;padding:7px 10px}main{max-width:1240px;margin:auto;padding:35px 38px}.intro{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-bottom:30px}.eyebrow{font-size:10px;letter-spacing:.18em;color:#69d3b7;font-weight:700}h1{font-size:29px;letter-spacing:-.04em;margin:10px 0}h2{font-size:18px;font-weight:600;margin:0}h3{font-size:14px;margin:0}p{line-height:1.65;color:#91a0b3;margin:8px 0}nav{display:flex;border-bottom:1px solid #26303d;gap:28px}nav button{border:0;border-radius:0;background:transparent;padding:15px 0;color:#9ba8ba}nav button.active{border-bottom:2px solid #67e3bf;color:#eef9f5}nav span{margin-left:5px;border-radius:5px;background:#24313f;padding:2px 6px;font-size:10px}button,input,textarea,select{font:inherit}button{border:1px solid #344252;background:#17212d;color:#d9e5ef;border-radius:7px;padding:10px 13px;cursor:pointer;transition:background .15s}button:hover{background:#263447}button:disabled{opacity:.45;cursor:not-allowed}button.primary{background:#69e2bd;border-color:#69e2bd;color:#082b23;font-weight:700}button.primary:hover{background:#8cebd0}button.danger{color:#ef999b}button.small{padding:6px 9px;font-size:12px}.panel{padding-top:10px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:18px 0}.actions{display:flex;gap:8px;flex-wrap:wrap}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:13px}.card{background:#121c28;border:1px solid #273447;border-radius:10px;padding:20px;min-width:0}.card h3{font-size:16px;color:#edf5f4;overflow-wrap:anywhere}.card p{font-size:12px;min-height:38px}.card .actions{margin-top:18px}.card .badge{font-size:10px;color:#69d6b8;letter-spacing:.1em;margin-bottom:10px}.empty{grid-column:1/-1;border:1px dashed #344252;border-radius:10px;padding:28px;color:#9aaabd}.editor{background:#121b27;border:1px solid #344252;border-radius:11px;padding:23px;margin-top:20px}.editor>.section-head:first-child{margin-top:0}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}label{display:block;font-size:12px;color:#a8b9cb;margin-bottom:16px}input,textarea,select{display:block;width:100%;background:#0c141f;border:1px solid #344252;color:#e8edf2;border-radius:6px;padding:11px;margin-top:7px;min-width:0}textarea{resize:vertical;line-height:1.55}input:focus,select:focus,textarea:focus,button:focus-visible{outline:2px solid #69d9bd;outline-offset:2px}.hint{font-size:12px;color:#90a3b7;line-height:1.6}.step{border:1px solid #2e4050;background:#0d1621;border-radius:8px;margin:12px 0;padding:16px}.step-head{display:flex;justify-content:space-between;gap:15px;align-items:center;margin-bottom:12px}.step-num{font-size:11px;color:#7ad4bd;font-weight:700;letter-spacing:.1em}.step .form-grid{grid-template-columns:1fr 1fr}.step label:last-child{margin-bottom:0}.editor-footer{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-top:20px}.code,pre{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px}pre{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.7;border:1px solid #2b3849;background:#0b1420;padding:17px;border-radius:7px;max-height:440px;overflow:auto}details{border-top:1px solid #2b3849;padding:13px 0}summary{cursor:pointer;font-size:12px;color:#b7c4d2}#notice{min-height:22px;font-size:12px;margin:12px 0}#notice.error{color:#ffb0b0}.unavailable{color:#d2b586!important}footer{border-top:1px solid #26303d;margin-top:40px;padding:22px 0;font-size:11px;color:#728599;line-height:1.8}footer span{color:#62758c}[hidden]{display:none!important}@media(max-width:700px){header{padding:0 20px}.pill{font-size:8px}main{padding:25px 20px}.intro{display:block}.intro button{margin-top:15px}h1{font-size:25px}.form-grid,.step .form-grid{grid-template-columns:1fr}.editor{padding:16px}nav{gap:22px}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"mSSGBWFpHazBWjNr0CYfSc/b7z8AjqBZJxWmKVpfgILJuhuDwZqWytMIO+BbCytkG63iYCJVYjxyoj4TF4lqAQ=="}