x}\n.product-v2 #btn-feedback{min-height:18px;line-height:1.4;padding:2px 10px}\n.product-v2 .rail-icons{padding-top:5px}\n.product-v2 .rail-icon{min-height:32px;height:32px}\n.product-v2 #nav .nav-group-label{padding:7px 12px;min-height:30px}\n.product-v2 #nav-items-toolkit{transition:none}\n@media(max-height:820px){.product-v2 #sidebar{padding-top:10px;padding-bottom:8px;gap:5px}.product-v2 #nav{min-height:80px}.product-v2 .product-sidebar-credits>strong{font-size:25px}}\n/* At the desktop's minimum height, allow the whole rail to scroll so its\n   controls remain reachable instead of clipping fixed regions. */\n@media(max-height:650px){.product-v2 #sidebar{overflow-y:auto}.product-v2 #nav{flex:0 0 auto;max-height:none}.product-v2 .rail-icons,.product-v2 .local-note{flex-shrink:0}}\n\n.product-v2 .product-purchase-notice{margin:12px 0;padding:12px 0;border-top:1px solid var(--border)}\n.product-v2 .product-purchase-notice p{margin:0;font-size:12px;line-height:1.6;overflow-wrap:anywhere}\n.product-v2 .product-purchase-notice .product-actions{margin-top:8px;gap:8px;flex-wrap:wrap}\n.product-v2 .product-purchase-unlock{margin:14px 0;padding:14px;border:1px solid var(--border);border-radius:10px;background:var(--bg-raised)}\n.product-v2 .product-purchase-unlock[hidden]{display:none}\n.product-v2 .product-purchase-unlock input{display:block;width:100%;box-sizing:border-box;margin-top:8px}\n.product-v2 .product-purchase-unlock .product-actions{margin-top:10px}\n.product-v2 #product-purchase-unlock-error{margin:8px 0 0;color:var(--danger,#b42318)}\n.product-v2 #product-quote-refresh:disabled{background:#e6edf8;color:#667793;border-color:#d3deed;cursor:default;opacity:1}\n/* Product pages use one natural document flow and one scrollbar. A flex child\n   must not shrink the sharing panel to make room for account history. */\n.product-v2 #main{min-height:0;overflow:clip}\n.product-v2 .workspace-header{flex:0 0 auto}\n.product-v2 .product-page,.product-v2 #view-earn{display:block;flex:1 1 0;height:auto;min-height:0;overflow:auto;overscroll-behavior:contain;scrollbar-gutter:stable}\n.product-v2 .product-earn{overflow:visible}\n.product-v2 .product-head,.product-v2 .product-panel,.product-v2 .product-two{flex-shrink:0}\n.product-v2 #product-legacy-account{margin:26px 0 0;padding:18px 0;border-top:1px solid var(--border)}\n.product-v2 #product-legacy-account>summary{font-size:12px;line-height:1.5}\n.product-v2 #product-legacy-account>.api-card{padding:22px 0;max-width:none;width:100%;overflow:visible}\n.product-v2 #product-wallet-controls{max-width:900px}\n.product-v2 #product-wallet-controls h2{margin:22px 0 12px}\n.product-v2 #product-wallet-controls .hint{line-height:1.6;margin:10px 0}\n.product-v2 #product-wallet-controls .form-row{margin:12px 0;flex-wrap:wrap}\n.product-v2 #product-wallet-controls input{min-width:0}\n.product-v2 #product-wallet-controls .snippet{overflow-wrap:anywhere;white-space:pre-wrap}\n.product-v2 #product-provider-readiness{margin-top:8px}\n.product-v2 #product-provider-label{font-size:clamp(25px,2.5vw,38px);overflow-wrap:anywhere}\n.product-v2 #product-provider-label[data-state=\"online\"]{font-size:clamp(32px,3vw,46px)}\n.product-v2 #product-completed-count[data-unreported=\"true\"]{font-size:25px;letter-spacing:-.5px}\n\n.product-v2 .product-two.product-single{grid-template-columns:1fr}\n.product-v2 #network-model-price{font-size:10px;color:var(--text-dim);overflow-wrap:anywhere}\n\n.product-v2 #product-provider-check h3{font-size:13px;margin:20px 0 8px}\n.product-v2 #product-provider-check progress{width:100%;height:9px;accent-color:var(--violet)}\n.product-v2 #product-provider-check .product-actions{margin-top:12px}\n.product-v2 #product-provider-check [data-check-export]{overflow-wrap:anywhere}\n\n.product-v2 #product-provider-model-pick{display:block;width:100%;margin-top:8px;padding:10px 12px;border:1px solid var(--border);border-radius:10px}\n\n.product-v2 #product-local-payment{white-space:pre-wrap;overflow-wrap:anywhere}.product-v2 .product-payment-transaction{display:block;overflow-wrap:anywhere}\n\n/* Keep the purchase itself in view; errors appear only when action is needed. */\n.product-v2 #view-buy-credits .product-head{margin-bottom:16px}\n.product-v2 #view-buy-credits .product-steps{display:none}\n.product-v2 #view-buy-credits .product-packs{margin:12px 0}\n.product-v2 #view-buy-credits .product-packs button{padding:12px 4px}\n.product-v2 #view-buy-credits .product-balance{font-size:38px;margin:8px 0 12px}\n.product-v2 #view-buy-credits .product-order>.primary{width:100%;margin-top:12px}\n.product-v2 #view-buy-credits .product-panel{padding:18px}\n.product-v2 #product-provider-options>summary{cursor:pointer;color:var(--text-dim);font-size:12px;padding:4px 0}\n.product-v2 #product-provider-options[open]>summary{margin-bottom:12px}\n@media(min-width:700px){.product-v2 #view-buy-credits .product-two{grid-template-columns:1fr 1fr}}\n\n.product-v2 #view-recovery #credit-run-results{padding:18px 0;border-top:1px solid var(--border);margin-top:24px}.product-v2 #credit-run-results>summary{font-size:13px;font-weight:600;cursor:pointer}.product-v2 #credit-run-history summary{cursor:pointer;font-size:12px}.product-v2 #credit-run-history{overflow-wrap:anywhere}\n\n.product-v2 #network-paid-first{width:auto;flex:none}.product-v2 .setting-toggle{display:flex;align-items:flex-start;gap:10px;line-height:1.6}\n\n/* Main wallet follows the node wallet's address, native balances and activity layout. */\n.product-v2 #view-payment-wallet{padding-bottom:40px}\n.product-v2 #view-payment-wallet .product-head{max-width:1000px;margin-bottom:20px}\n.product-v2 #product-wallet-controls{max-width:1000px}\n.product-v2 .payment-wallet-actions,.product-v2 .payment-wallet-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n.product-v2 .payment-wallet-actions{justify-content:flex-end}\n.product-v2 .payment-wallet-row{justify-content:space-between}\n.product-v2 .payment-wallet-card{background:var(--bg-raised);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:16px}\n.product-v2 #product-wallet-controls .payment-wallet-card h2{font-size:15px;margin:0 0 10px}\n.product-v2 .payment-wallet-card .hint,.product-v2 #payment-wallet-balance-note{font-size:12px;color:var(--text-dim);line-height:1.5;margin:6px 0 12px}\n.product-v2 #payment-wallet-receive{flex-wrap:nowrap;justify-content:flex-start}\n.product-v2 #payment-wallet-receive input{flex:1;min-width:0;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:13px;background:var(--bg-input);border:1px solid var(--border);padding:11px 12px;border-radius:8px}\n.product-v2 #payment-wallet-receive button,.product-v2 #payment-wallet-explorer{flex:none}\n.product-v2 #payment-wallet-explorer{font-size:12px;color:var(--violet);text-decoration:none;padding:9px 10px}\n.product-v2 .payment-wallet-badge{font-size:11px;color:var(--text-dim);padding:4px 9px;border:1px solid var(--border);border-radius:99px}\n.product-v2 #wallet-balances.payment-wallet-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;background:none;border:0;padding:0;margin:0}\n.product-v2 .payment-wallet-stat{border:1px solid var(--border);border-radius:10px;padding:16px;background:#edf3fc;min-width:0}\n.product-v2 .payment-wallet-stat .label{font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--text-dim)}\n.product-v2 .payment-wallet-stat .value{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:23px;line-height:1.35;margin-top:8px;overflow-wrap:anywhere;color:var(--text)}\n.product-v2 .payment-wallet-stat .sub{font-size:11px;line-height:1.5;color:var(--text-dim);margin-top:5px}\n.product-v2 #btn-wallet-balances{font-size:11px;margin-bottom:16px;padding:6px 10px}\n.product-v2 .payment-wallet-history .payment-wallet-row h2{margin:0!important}\n.product-v2 .payment-wallet-table{overflow:auto;max-width:100%;margin-top:8px}\n.product-v2 .payment-