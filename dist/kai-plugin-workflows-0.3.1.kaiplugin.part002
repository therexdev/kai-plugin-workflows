ng:12px}.hub-metrics{gap:14px}.hub-metrics b{font-size:20px}.hub-metrics .hub-check{width:100%}}\n\n.companion-hub{overflow-y:auto;width:100%;display:block}.companion-hub .hub-header{flex-shrink:0}.companion-hub .error{color:var(--danger)}\n\n#view-brain, #view-workflows, #view-connections, #view-agents { overflow-y: auto; }\n\n/* App connections: catalog, account cards and guided connection drawer. */\n.cn-workspace{color:var(--text);min-width:0}.cn-workspace button{font-family:inherit;cursor:pointer}.cn-workspace .cn-button{background:#fff;border:1px solid #d5e2f3;color:#29456b;padding:9px 14px;min-height:36px;border-radius:9px;box-shadow:0 1px 2px #1b43700a;line-height:1.35}.cn-workspace .cn-button:hover{background:#f0f6ff;border-color:#a5c5fa}.cn-workspace .cn-button.cn-primary{color:#fff;background:#1765ef;border-color:#1765ef;box-shadow:0 3px 10px #1765ef1c}.cn-workspace button:disabled{opacity:.55;cursor:default}.cn-workspace button:focus-visible,.cn-workspace input:focus-visible,.cn-workspace select:focus-visible{outline:2px solid #1765ef;outline-offset:3px}.cn-notice{font-size:13px;line-height:1.6;border-radius:10px;padding:12px 15px;background:#eaf2ff;margin-bottom:16px;overflow-wrap:anywhere}.cn-notice:empty{display:none}.cn-notice.cn-error{background:#fff1ed;color:#a6412c}.cn-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;background:linear-gradient(110deg,#e8f1ff,#f0f6ff 65%,#e8f7f9);padding:28px;border:1px solid #dce8f9;border-radius:18px;margin-bottom:24px}.cn-kicker{font-size:9px;letter-spacing:.16em;font-weight:750;color:#1765ef}.cn-hero h2{font-size:25px;letter-spacing:-.03em;line-height:1.2;margin:12px 0}.cn-hero p{color:#617590;font-size:13px;line-height:1.7;max-width:500px;margin:0}.cn-route{display:flex;align-items:center;gap:7px;flex:none;font-size:11px;background:#ffffffbd;padding:5px 5px 5px 11px;border:1px solid #dce8f9;border-radius:25px;white-space:nowrap}.cn-route .cn-button{font-size:10px;padding:5px 8px;